+      // Keep memory bounded even before the end-of-depth beam cut.
+      if(j.next.length>192){j.next.sort(function(a,b){return compare(b.score,a.score);});j.next.length=48;}
+      if(trio && n.triples>=2 && (!j.best || compare(n.score,j.best.score)>0)){
+        // Never downgrade a proved mission-first baseline for a normal route.
+        if(j.fallback.stats.missionStatus==='priority' && n.firstType!==input.mission.type)continue;
+        j.best={proof:n.first,triples:n.triples,score:n.score,empty:n.removed.size===j.cards.length&&n.occupancy===0};
+      }
+    }
+    if(j.nodes>=12000 || j.slices>=24 || j.depth>=18)return finish();
+    return {status:'searching',reason:'search_in_progress',stats:Object.assign({},j.fallback.stats,
+      {goal:'multi_trio',lookaheadDepth:j.depth,lookaheadNodes:j.nodes,lookaheadSlices:j.slices,completeSearch:false})};
+  };
+})
