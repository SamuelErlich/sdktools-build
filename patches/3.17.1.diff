+static NSArray<UIViewController *> *STVisibleControllersChecked(UIWindow *window, BOOL *complete) {
+    NSMutableArray *found = [NSMutableArray array];
+    NSMutableArray *pending = [NSMutableArray array];
+    if (window.rootViewController) [pending addObject:window.rootViewController];
+    NSHashTable *seen = [NSHashTable weakObjectsHashTable];
+    BOOL untruncated = YES;
+    for (NSUInteger visit = 0; pending.count && visit < 32; visit++) {
+        UIViewController *controller = pending.firstObject;
+        [pending removeObjectAtIndex:0];
+        if ([seen containsObject:controller]) continue;
+        [seen addObject:controller];
+        if (controller.isViewLoaded && controller.view.window == window && !controller.view.hidden)
+            [found addObject:controller];
+        if (controller.presentedViewController) [pending addObject:controller.presentedViewController];
+        for (UIViewController *child in controller.childViewControllers) {
+            if (pending.count >= 32) { untruncated = NO; break; }
+            [pending addObject:child];
+        }
+    }
+    if (complete) *complete = untruncated && !pending.count;
+    return found;
+}
