+    [button setImage:[UIImage systemImageNamed:symbol] forState:UIControlStateNormal];
+    [button setTitleColor:UIColor.whiteColor forState:UIControlStateNormal];
+    button.tintColor = primary ? UIColor.whiteColor : STOrange();
+    button.backgroundColor = primary ? [UIColor colorWithRed:0.8 green:0.22 blue:0.07 alpha:1] : [UIColor colorWithWhite:0.115 alpha:1];
+    button.titleLabel.font = [[UIFontMetrics metricsForTextStyle:UIFontTextStyleBody] scaledFontForFont:[UIFont systemFontOfSize:12 weight:UIFontWeightSemibold]];
+    button.titleLabel.adjustsFontForContentSizeCategory = YES;
+    button.titleLabel.numberOfLines = 2;
+    button.titleLabel.textAlignment = NSTextAlignmentCenter;
+    button.layer.cornerRadius = 12;
+    button.contentEdgeInsets = UIEdgeInsetsMake(11, 8, 11, 8);
