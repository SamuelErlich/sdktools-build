+        if (window==overlay || window.hidden || window.alpha<0.01 || window.screen!=overlay.screen) continue;
+        if (window.windowLevel>UIWindowLevelNormal) continue;
+        NSMutableArray<UIView *> *pending=[NSMutableArray arrayWithObject:window];
+        while (pending.count) {
+            if (++visited>512) return nil;
+            UIView *view=pending.lastObject; [pending removeLastObject];
+            if (view.hidden || view.alpha<0.01) continue;
+            if ([view isKindOfClass:unityClass]) { if (found && found!=view) return nil; found=view; continue; }
+            if (pending.count+view.subviews.count>512) return nil;
+            [pending addObjectsFromArray:view.subviews];
