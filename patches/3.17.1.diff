+- (NSArray<NSMutableDictionary *> *)beforeEvent:(UIEvent *)event {
+    if (!self.isRecording || event.type != UIEventTypeTouches) return @[];
+    NSTimeInterval now = STNow();
+    if (now - self.startedAt >= STMaximumDuration) { [self stopRecordingWithReason:@"durationLimit"]; return @[]; }
+    NSMutableArray *accepted = [NSMutableArray array];
+    NSNumber *beforeID = self.snapshots.lastObject[@"id"];
+    BOOL sampledBefore = NO;
+    BOOL scopeValidated = NO;
+    for (UITouch *touch in event.allTouches) {
+        UITouchPhase phase = touch.phase;
+        if (phase != UITouchPhaseBegan && phase != UITouchPhaseMoved && phase != UITouchPhaseEnded && phase != UITouchPhaseCancelled) continue;
+        NSString *exclusion = STTouchExclusion(touch);
+        if (exclusion) { [self countOmitted:exclusion]; continue; }
+        if (self.detectedGameCaptureScoped && touch.view != self.detectedGameWebView &&
+            ![touch.view isDescendantOfView:self.detectedGameWebView]) {
+            [self countOmitted:@"outsideConfirmedGame"]; continue;
+        }
+        if (self.touches.count >= STMaximumTouchSamples) break;
+        NSNumber *touchID = [self.touchIDs objectForKey:touch];
+        BOOL missingBegin = !touchID && phase != UITouchPhaseBegan;
+        if (!touchID) { touchID = @(++self.nextTouchID); [self.touchIDs setObject:touchID forKey:touch]; }
+        if (phase == UITouchPhaseMoved) {
+            NSTimeInterval last = [self.lastMove[touchID] doubleValue];
+            if (last && now - last < STMoveInterval) { [self countOmitted:@"moveThrottled"]; continue; }
+            self.lastMove[touchID] = @(now);
+        }
+        // Excluded overlay/input events and throttled 60 Hz move samples do
+        // not rescan native windows. Revalidate before accepting any data.
+        if (self.detectedGameCaptureScoped && !scopeValidated) {
+            if (![self newGameContextIsCurrent]) return accepted;
+            scopeValidated = YES;
+        }
+        if (phase == UITouchPhaseBegan && !sampledBefore && now - self.lastEventSnapshotAt >= 0.3 &&
+            self.eventSnapshotCount < STMaximumEventSnapshots) {
+            NSNumber *captured = [self captureSnapshot:@"beforeTouch"];
+            if (captured) { beforeID = captured; self.eventSnapshotCount++; self.lastEventSnapshotAt = now; }
+            sampledBefore = YES;
+        }
+        if (!self.isRecording) break;
+        UIWindow *window = touch.window;
+        CGPoint point = [touch locationInView:window];
+        CGRect bounds = window.bounds;
+        NSMutableDictionary *entry = [@{@"sequence": @(self.touches.count + 1), @"touchID": touchID,
+            @"phase": STTouchPhase(phase), @"missingBegin": @(missingBegin),
+            @"elapsedMs": @(STFinite((now - self.startedAt) * 1000)),
+            @"touchTimestampElapsedMs": @(STFinite((touch.timestamp - self.startedAt) * 1000)),
+            @"pointInWindow": STPoint(point), @"windowBoundsPoints": STRect(bounds),
+            @"normalized": STPoint(CGPointMake(bounds.size.width > 0 ? (point.x - bounds.origin.x) / bounds.size.width : 0,
+                                               bounds.size.height > 0 ? (point.y - bounds.origin.y) / bounds.size.height : 0)),
+            @"orientation": @(window.windowScene.interfaceOrientation),
+            @"viewClass": STClassName(touch.view), @"windowClass": STClassName(window),
+            @"beforeSnapshotID": beforeID ?: NSNull.null} mutableCopy];
+        if (![self reservePayloadObject:entry]) break;
+        [self.touches addObject:entry]; [accepted addObject:entry];
+        if (phase == UITouchPhaseEnded || phase == UITouchPhaseCancelled) {
+            [self.touchIDs removeObjectForKey:touch]; [self.lastMove removeObjectForKey:touchID];
+        }
+    }
+    return accepted;
+}
