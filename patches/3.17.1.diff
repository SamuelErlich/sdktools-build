+- (BOOL)setCardHintsEnabled:(BOOL)enabled {
+    NSAssert(NSThread.isMainThread, @"STRecorder requires the main thread");
+    if (enabled && !ST_CARD_GAME_FEATURE_ENABLED) return NO;
+    if (!enabled) {
+        if (!self.cardHintsRequested && !self.cardHintsHasRuntime) return YES;
+        self.cardHintsRequested = NO;
+        self.cardHintsSessionGeneration++;
+        [self.cardHintsTimer invalidate]; self.cardHintsTimer = nil;
+        [self.webProbe hideCardHints];
+        self.cardHintsHasRuntime = NO;
+        self.cardHintsWebView = nil; self.cardHintsController = nil; self.cardHintsDocumentURL = nil;
+        [self acceptCardHintsDiagnostic:@{@"status": @"off", @"reason": @"user_disabled", @"shown": @0, @"unknown": @0, @"unavailable": @0}];
+        [self notifyChange];
+        return YES;
+    }
+    if (self.cardHintsEnabled) return YES;
+    if (self.cardHintsBusy || self.autoplayBusy || self.returnActionBusy || self.sourceExportBusy ||
+        self.isRecording || self.cardEarlyActive || self.detectedGameDetectionActive || UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return NO;
+    NSNumber *type = nil; UIViewController *controller = nil; NSString *reason = nil;
+    WKWebView *webView = STFindCaptureGame(&type, &controller, &reason);
+    if (!webView || ![type isEqual:@2007] || !webView.URL) {
+        [self acceptCardHintsDiagnostic:@{@"status": @"blocked", @"reason": webView && ![type isEqual:@2007] ? @"different_game" : (reason ?: @"native_context_unavailable"), @"shown": @0, @"unknown": @0, @"unavailable": @0}];
+        return NO;
+    }
+    [self pauseAutoplayWithReason:@"user"];
+    [self setXrayEnabled:NO];
+    self.cardHintsSessionGeneration++;
+    self.cardHintsWebView = webView; self.cardHintsController = controller; self.cardHintsDocumentURL = webView.URL;
+    self.cardHintsRequested = YES;
+    [self acceptCardHintsDiagnostic:@{@"status": @"waiting", @"reason": @"starting", @"shown": @0, @"unknown": @0, @"unavailable": @0}];
+    __weak STRecorder *weakSelf = self;
+    self.cardHintsTimer = [NSTimer timerWithTimeInterval:0.15 repeats:YES block:^(__unused NSTimer *timer) { [weakSelf cardHintsTick]; }];
+    self.cardHintsTimer.tolerance = 0.015;
+    [[NSRunLoop mainRunLoop] addTimer:self.cardHintsTimer forMode:NSRunLoopCommonModes];
+    [self cardHintsTick];
+    [self notifyChange];
+    return YES;
+}
+
+- (BOOL)cardHintsContextMatches {
+    if (!ST_CARD_GAME_FEATURE_ENABLED) return NO;
+    NSNumber *type = nil; UIViewController *controller = nil;
+    WKWebView *webView = STFindCaptureGame(&type, &controller, NULL);
+    return self.cardHintsEnabled && webView && [type isEqual:@2007] &&
+        webView == self.cardHintsWebView && controller == self.cardHintsController &&
+        webView.URL && [webView.URL isEqual:self.cardHintsDocumentURL];
+}
+
+- (void)cardHintsTick {
+    if (!ST_CARD_GAME_FEATURE_ENABLED) return;
+    if (!self.cardHintsEnabled || self.cardHintsBusy) return;
+    if (self.isRecording || self.cardEarlyActive || self.detectedGameDetectionActive || self.sourceExportBusy || self.returnActionBusy || self.autoplayEnabled || self.xrayEnabled ||
+        UIApplication.sharedApplication.applicationState != UIApplicationStateActive) { [self setCardHintsEnabled:NO]; return; }
+    NSNumber *type = nil; UIViewController *controller = nil; NSString *reason = nil;
+    WKWebView *webView = STFindCaptureGame(&type, &controller, &reason);
+    if (!webView) {
+        if (self.cardHintsHasRuntime) { [self.webProbe hideCardHints]; self.cardHintsHasRuntime = NO; }
+        BOOL temporary = [@[@"native_modal_visible", @"native_view_obscured", @"ambiguous_window_overlap"] containsObject:reason];
+        if (!temporary) [self setCardHintsEnabled:NO];
+        [self acceptCardHintsDiagnostic:@{@"status": @"blocked", @"reason": reason ?: @"native_context_unavailable", @"shown": @0, @"unknown": @0, @"unavailable": @0}];
+        return;
+    }
+    if (![type isEqual:@2007] || webView != self.cardHintsWebView || controller != self.cardHintsController ||
+        !webView.URL || ![webView.URL isEqual:self.cardHintsDocumentURL]) {
+        [self setCardHintsEnabled:NO];
+        [self acceptCardHintsDiagnostic:@{@"status": @"blocked", @"reason": @"document_changed", @"shown": @0, @"unknown": @0, @"unavailable": @0}];
+        return;
+    }
+    self.cardHintsBusy = YES;
+    NSUInteger generation = self.cardHintsSessionGeneration;
+    __weak STRecorder *weakSelf = self;
+    __block BOOL callbackOccurred = NO;
+    BOOL accepted = [self.webProbe performCardHintsInWebView:webView sessionGeneration:generation
+        validateContext:^BOOL {
+            STRecorder *strongSelf = weakSelf;
+            return strongSelf && strongSelf.cardHintsSessionGeneration == generation && [strongSelf cardHintsContextMatches];
+        } update:^(NSDictionary *result) {
+            STRecorder *strongSelf = weakSelf;
+            if (!strongSelf) return;
+            callbackOccurred = YES;
+            BOOL pending = [result[@"physicalPending"] boolValue];
+            strongSelf.cardHintsBusy = pending;
+            if (strongSelf.cardHintsSessionGeneration != generation || !strongSelf.cardHintsEnabled) { [strongSelf notifyChange]; return; }
+            NSString *resultReason = result[@"reason"];
+            if (pending || [@[@"document_changed", @"runtime_context_unverified", @"namespace_conflict", @"invalid_result", @"renderer_script_missing", @"context_limit", @"evaluation_failed"] containsObject:resultReason])
+                [strongSelf setCardHintsEnabled:NO];
+            else if ([resultReason isEqual:@"native_context_changed"] && strongSelf.cardHintsHasRuntime) {
+                [strongSelf.webProbe hideCardHints]; strongSelf.cardHintsHasRuntime = NO;
+            }
+            [strongSelf acceptCardHintsDiagnostic:result];
+            [strongSelf notifyChange];
+        }];
+    if (accepted && self.cardHintsEnabled && self.cardHintsSessionGeneration == generation) self.cardHintsHasRuntime = YES;
+    else if (!callbackOccurred) self.cardHintsBusy = NO;
+}
