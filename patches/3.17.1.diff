 /* The bridge is an untrusted producer for drawing purposes. Preserve only the
  * explicit scalar schema; never serialize arbitrary objects returned by Lua. */
+// Acquisition diagnostics never authorize prediction or drawing.
+static NSDictionary *STBLAcquisition(id input) {
+    if (![input isKindOfClass:NSDictionary.class] || !STBLBoolean(input[@"frameFound"])) return nil;
+    int64_t schema;
+    if (!STBLInteger(input[@"schemaVersion"],1,1,&schema)) return nil;
+    NSArray *positions=input[@"positions"];
+    if (![positions isKindOfClass:NSArray.class] || positions.count>16 ||
+        (![input[@"frameFound"] boolValue] && positions.count)) return nil;
+    NSMutableArray *safe=[NSMutableArray array]; uint32_t seen=0;
+    for (id item in positions) {
+        if (![item isKindOfClass:NSDictionary.class]) return nil;
+        int64_t tag,number; double x,y,z;
+        NSDictionary *world=item[@"world"];
+        if (![world isKindOfClass:NSDictionary.class] || !STBLInteger(item[@"tag"],1,16,&tag) ||
+            !STBLInteger(item[@"number"],0,15,&number) || !STBLValidIdentityBall(tag,number,&seen) ||
+            !STBLNumber(world[@"x"],-20,20,&x) || !STBLNumber(world[@"y"],-.5,.5,&y) ||
+            !STBLNumber(world[@"z"],-20,20,&z)) return nil;
+        [safe addObject:@{@"tag":@(tag),@"number":@(number),@"world":@{@"x":@(x),@"y":@(y),@"z":@(z)}}];
+    }
+    return @{@"schemaVersion":@1,@"frameFound":input[@"frameFound"],@"positionCount":@(safe.count),@"positions":safe};
+}
