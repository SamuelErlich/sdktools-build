+- (void)performPowerSlot:(NSString *)slot command:(NSString *)command {
+    if (STBilliardsRuntime.shared.enabled) { [self showNotice:@"Desative a leitura do bilhar para usar o Alpaca."]; return; }
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Aguarde a exportação terminar."]; return; }
+    if (self.controller.presentedViewController || self.pendingPreview ||
+        self.videoState == STVideoStarting || self.videoState == STVideoStopping) {
+        [self showNotice:@"Feche a janela aberta e aguarde o vídeo terminar de iniciar ou salvar."];
+        return;
+    }
+    [self showNotice:[command isEqual:@"confirm"] ? @"Conferindo o poder aberto e o estoque…" : @"Abrindo o poder original…"];
+    __weak STOverlay *weakSelf = self;
+    BOOL accepted = [STRecorder.shared performOriginalPowerAtSlot:slot command:command update:^(NSDictionary *result) {
+        STOverlay *strongSelf = weakSelf;
+        if (!strongSelf) return;
+        NSString *status = result[@"status"], *reason = result[@"reason"];
+        if ([status isEqualToString:@"original_event_dispatched"]) {
+            [strongSelf showNotice:[command isEqual:@"confirm"] ? @"Uso solicitado ao jogo. Aguarde o efeito antes de usar novamente." : @"Confira o efeito e confirme Usar item no jogo."];
+        } else if ([status isEqualToString:@"dispatch_uncertain"]) {
+            [strongSelf showNotice:[result[@"physicalPending"] boolValue] ?
+                @"Resposta incerta. Aguarde o jogo; o poder permanece bloqueado enquanto essa chamada não terminar." :
+                @"A resposta não pôde ser confirmada. Confira a tela do jogo antes de tocar novamente."];
+        } else if ([@[@"return_action_pending", @"physical_operation_pending", @"cleanup_pending"] containsObject:reason]) {
+            [strongSelf showNotice:@"Há uma leitura ou ação em andamento. Aguarde antes de tocar novamente."];
+        } else if ([@[@"native_modal_visible", @"modal_visible", @"native_view_obscured", @"ambiguous_window_overlap"] containsObject:reason]) {
+            [strongSelf showNotice:@"Já existe uma janela aberta. Resolva ou feche essa janela no jogo."];
+        } else if ([@[@"disabled_control", @"button_unavailable", @"stock_unavailable", @"stock_empty"] containsObject:reason]) {
+            [strongSelf showNotice:@"O poder não está disponível ou está sem estoque. Confira a partida."];
+        } else if ([@[@"confirmation_unavailable", @"confirmation_ambiguous", @"prop_mismatch"] containsObject:reason]) {
+            [strongSelf showNotice:@"Abra o poder desejado e confira sua confirmação no jogo. A janela pode fechar após alguns segundos."];
+        } else if ([@[@"unsupported_application", @"engine_version", @"game_type_abi_mismatch"] containsObject:reason]) {
+            [strongSelf showNotice:@"Esta versão do jogo não corresponde ao controle verificado para US 6.6.2."];
+        } else {
+            [strongSelf showNotice:@"Não foi possível identificar esse poder nesta tela. Entre na partida e exporte um relatório se continuar."];
+        }
+        [strongSelf refresh];
+    }];
+    // Only an accepted request can collapse the panel. Rejections keep the
+    // explanation and controls visible. No synthetic tap or automatic retry.
+    if (accepted && self.controller.expanded) [self.controller togglePanel];
+    [self refresh];
+}
+
+- (void)stopCapture { [self stopAllWithReason:@"user"]; }
+
+- (void)stopAllWithReason:(NSString *)reason {
+    [STRecorder.shared stopCardEarlyCaptureWithReason:reason];
+    [STRecorder.shared setCardHintsEnabled:NO];
+    [STBilliardsRuntime.shared stopWithReason:reason];
+    if (STRecorder.shared.detectedGameDetectionActive) {
+        [STRecorder.shared cancelNewGameDetection];
+        [self showNotice:@"Detecção cancelada."]; return;
+    }
+    if (self.videoState != STVideoIdle) {
+        self.pendingStopReason = reason;
+        if (self.videoState == STVideoStarting) self.stopWhenStarted = YES;
+        else if (self.videoState == STVideoRecording) [self stopVideo];
+    } else {
+        [STRecorder.shared stopRecordingWithReason:reason];
+        [self showNotice:@"Captura encerrada. O relatório está pronto para exportar."];
+    }
+}
