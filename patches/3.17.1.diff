+- (BOOL)beginReturnTrace {
+    NSAssert(NSThread.isMainThread, @"STRecorder requires the main thread");
+    if (self.detectedGameCaptureScoped || self.detectedGameDetectionActive || !self.isRecording || self.returnTraceActive || self.markers.count >= STMaximumMarkers) return NO;
+    self.returnTraceRequested = YES;
+    self.returnTraceActive = YES;
+    self.returnTraceStartedElapsedMs = STFinite(MAX(0, (STNow() - self.startedAt) * 1000));
+    [self.webProbe setTraceControlsEnabled:YES];
+    [self markEvent:@"returnTraceStarted" details:@{@"source": @"overlay"}];
+    [self notifyChange];
+    return self.isRecording && self.returnTraceActive;
+}
