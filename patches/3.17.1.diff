+- (NSString *)statusText {
+    if (!NSThread.isMainThread) return @"Consulte na thread principal";
+    if ([self.startFailure isEqualToString:@"inactiveApplication"]) return @"Abra o app para iniciar a captura";
+    if ([self.startFailure isEqualToString:@"eventObservationUnavailable"]) return @"Não foi possível observar os toques";
+    NSTimeInterval duration = self.startedAt > 0 ? (self.isRecording ? STNow() : self.stoppedAt) - self.startedAt : 0;
+    if (!self.startedAt) return @"Nenhuma captura iniciada";
+    NSString *label = self.isRecording ? @"Gravando" : @"Captura pronta";
+    if (!self.isRecording && [self.stopReason isEqual:@"payloadLimit"]) label = @"Limite de 32 MiB atingido";
+    else if (!self.isRecording && [self.stopReason isEqual:@"durationLimit"]) label = @"Limite de 180 s atingido";
+    else if (!self.isRecording && [self.stopReason isEqual:@"touchLimit"]) label = @"Limite de toques atingido";
+    NSDictionary *last = self.webSamples.lastObject;
+    id cocos = last[@"cocos"];
+    id descendants = [cocos isKindOfClass:NSDictionary.class] ? cocos[@"descendantNodeCount"] : nil;
+    id sprites = [cocos isKindOfClass:NSDictionary.class] ? cocos[@"spriteNodeCount"] : nil;
+    NSString *sceneDetail = @"Aguardando leitura da cena";
+    NSString *status = [last[@"status"] isKindOfClass:NSString.class] ? last[@"status"] : @"";
+    BOOL sceneObserved = [status isEqualToString:@"cocos2_scene_captured"] ||
+        [status isEqualToString:@"cocos2_scene_observed_empty"];
+    if (sceneObserved && [descendants isKindOfClass:NSNumber.class] && [sprites isKindOfClass:NSNumber.class]) {
+        sceneDetail = [descendants unsignedIntegerValue] > 0 ?
+            [NSString stringWithFormat:@"Última leitura: %lu elementos · %lu sprites",
+                (unsigned long)[descendants unsignedIntegerValue], (unsigned long)[sprites unsignedIntegerValue]] :
+            @"Última leitura: sem elementos observados";
+    } else if ([status isEqualToString:@"cocos2_scene_observed_incomplete"])
+        sceneDetail = @"Última leitura: observação incompleta";
+    else if (last) sceneDetail = @"Última leitura: cena indisponível";
+    if (self.returnTraceActive) sceneDetail = [sceneDetail stringByAppendingString:@"\nPoderes: rastreamento ativo"];
+    return [NSString stringWithFormat:@"%@ · %.0f s · %lu eventos de toque · %lu leituras\n%@", label,
+        MAX(0, duration), (unsigned long)self.touches.count, (unsigned long)self.webSamples.count, sceneDetail];
+}
