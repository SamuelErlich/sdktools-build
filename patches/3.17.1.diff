+- (void)markEvent:(NSString *)name details:(NSDictionary<NSString *,id> *)details {
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self markEvent:name details:details]; }); return;
+    }
+    if (!self.isRecording) return;
+    NSSet *names = [NSSet setWithArray:@[@"crazyAlpacaEntered", @"matchStarted", @"matchEnded", @"elementsObserved",
+        @"visualRecordingStarted", @"visualRecordingStopped", @"visualRecordingFailed", @"returnTraceStarted", @"returnActionRequested"]];
+    if (![names containsObject:name]) { [self countOmitted:@"unknownMarker"]; return; }
+    if (self.markers.count >= STMaximumMarkers) { [self countOmitted:@"markerLimit"]; return; }
+    NSMutableDictionary *safeDetails = [NSMutableDictionary dictionary];
+    id source = details[@"source"];
+    if ([source isKindOfClass:NSString.class] && [@[@"user", @"overlay", @"replaykit"] containsObject:source]) safeDetails[@"source"] = source;
+    id enabled = details[@"enabled"];
+    if ([enabled isKindOfClass:NSNumber.class]) safeDetails[@"enabled"] = @([enabled boolValue]);
+    id duration = details[@"durationSeconds"];
+    if ([duration isKindOfClass:NSNumber.class] && isfinite([duration doubleValue])) safeDetails[@"durationSeconds"] = @(MAX(0, MIN([duration doubleValue], 3600)));
+    NSTimeInterval elapsed = STNow() - self.startedAt;
+    NSNumber *snapshotID = [self captureSnapshot:@"userMarker"];
+    if (!self.isRecording) return;
+    NSDictionary *marker = @{@"name": name, @"elapsedMs": @(STFinite(elapsed * 1000)), @"details": safeDetails,
+                             @"snapshotID": snapshotID ?: NSNull.null,
+                             @"semanticConfirmation": @"userMarkerNotAutomaticDetection"};
+    if (![self reservePayloadObject:marker]) return;
+    [self.markers addObject:marker];
+    [self notifyChange];
+}
