+- (BOOL)acceptsPoint:(CGPoint)point {
+    CGPoint local = [self.view convertPoint:point fromView:self.view.window];
+    return CGRectContainsPoint(self.bubble.frame, local) || (self.expanded && CGRectContainsPoint(self.panel.frame, local));
+}
