+- (void)exportGameSources {
+    [STBilliardsRuntime.shared stopWithReason:@"export"];
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"A exportação do código já está em andamento."]; return; }
+    if (self.videoState != STVideoIdle || self.pendingPreview || self.controller.presentedViewController) {
+        [self showNotice:@"Pare o vídeo e feche a prévia ou janela aberta antes de exportar o código."];
+        return;
+    }
+    if (self.pendingSourceExportURL) { [self presentPendingSourceExport]; return; }
+    [self showNotice:@"Preparando o código do jogo. Aguarde sem sair da partida."];
+    __weak STOverlay *weakSelf = self;
+    [STRecorder.shared exportCurrentGameSourcesWithCompletion:^(NSURL *url, NSError *error) {
+        STOverlay *strongSelf = weakSelf;
+        if (!strongSelf) return;
+        if (!url.isFileURL || error) {
+            [strongSelf showNotice:error.localizedDescription ?: @"Não foi possível gerar o arquivo. Abra uma partida e tente novamente."];
+            [strongSelf refresh];
+            return;
+        }
+        strongSelf.pendingSourceExportURL = url;
+        strongSelf.pendingSourceExportIsBilliards = NO;
+        [strongSelf showNotice:@"Código pronto. Escolha Salvar em Arquivos ou compartilhar o JSON."];
+        [strongSelf presentPendingSourceExport];
+        [strongSelf refresh];
+    }];
+    [self refresh];
+}
+
+- (void)exportBilliardsResources {
+    [STBilliardsRuntime.shared stopWithReason:@"export"];
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Uma exportação já está em andamento."]; return; }
+    if (self.videoState != STVideoIdle || self.pendingPreview || self.controller.presentedViewController) {
+        [self showNotice:@"Pare o vídeo e feche a prévia ou janela aberta antes de exportar os recursos."]; return;
+    }
+    if (self.pendingSourceExportURL) { [self presentPendingSourceExport]; return; }
+    [self showNotice:@"Preparando os recursos. Mantenha o bilhar aberto até terminar."];
+    __weak STOverlay *weakSelf = self;
+    [STRecorder.shared exportBilliardsResourcesWithCompletion:^(NSURL *url, NSError *error) {
+        STOverlay *strongSelf = weakSelf;
+        if (!strongSelf) return;
+        if (!url.isFileURL || error) {
+            [strongSelf showNotice:error.localizedDescription ?: @"Não foi possível gerar o arquivo de recursos. Tente novamente."];
+            [strongSelf refresh]; return;
+        }
+        strongSelf.pendingSourceExportURL = url;
+        strongSelf.pendingSourceExportIsBilliards = YES;
+        NSUInteger exported = [STRecorder.shared.billiardsResourceExportDiagnostic[@"counts"][@"filesExported"] unsignedIntegerValue];
+        [strongSelf showNotice:exported ? @"Recursos prontos. Salve em Arquivos ou compartilhe o JSON." :
+            @"Diagnóstico pronto; recursos ainda não encontrados. Abra o bilhar, aguarde o carregamento e exporte novamente."];
+        [strongSelf presentPendingSourceExport];
+        [strongSelf refresh];
+    }];
+    [self refresh];
+}
+
+- (void)presentPendingSourceExport {
+    if (!self.pendingSourceExportURL || STRecorder.shared.sourceExportBusy ||
+        self.videoState != STVideoIdle || self.pendingPreview || self.controller.presentedViewController ||
+        UIApplication.sharedApplication.applicationState != UIApplicationStateActive || self.window.hidden) return;
+    NSURL *url = self.pendingSourceExportURL;
+    BOOL billiards = self.pendingSourceExportIsBilliards;
+    self.pendingSourceExportURL = nil;
+    self.pendingSourceExportIsBilliards = NO;
+    UIActivityViewController *share = [[UIActivityViewController alloc] initWithActivityItems:@[url] applicationActivities:nil];
+    UIView *anchor = self.controller.bubble;
+    share.popoverPresentationController.sourceView = anchor;
+    share.popoverPresentationController.sourceRect = anchor.bounds;
+    __weak STOverlay *weakSelf = self;
+    share.completionWithItemsHandler = ^(UIActivityType type, BOOL completed, NSArray *items, NSError *shareError) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [weakSelf showNotice:completed ? (billiards ? @"Arquivo do bilhar compartilhado." : @"Código do jogo compartilhado.") : @"Arquivo gerado. Você pode exportar novamente pelo menu."];
+            [weakSelf presentPendingPreview];
+        });
+    };
+    [self.controller presentViewController:share animated:YES completion:nil];
+}
