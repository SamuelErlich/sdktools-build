+static WKWebView *STFindGameWebView(UIView *root) {
+    NSMutableArray<NSDictionary *> *pending = [NSMutableArray arrayWithObject:@{@"view": root, @"depth": @0}];
+    for (NSUInteger visited = 0; pending.count && visited < 128; visited++) {
+        NSDictionary *item = pending.firstObject;
+        [pending removeObjectAtIndex:0];
+        UIView *view = item[@"view"];
+        NSUInteger depth = [item[@"depth"] unsignedIntegerValue];
+        if (!view.window || view.hidden || view.alpha < 0.01 || STIsTextEntry(view) || STIsKeyboard(view)) continue;
+        if ([view isKindOfClass:WKWebView.class]) return (WKWebView *)view;
+        if (depth >= 12) continue;
+        for (UIView *child in view.subviews) {
+            if (pending.count >= 128) break;
+            [pending addObject:@{@"view": child, @"depth": @(depth + 1)}];
+        }
+    }
+    return nil;
+}
