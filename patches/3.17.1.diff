+- (void)markVisualRecordingEndForSessionIdentifier:(NSString *)identifier failed:(BOOL)failed durationSeconds:(NSTimeInterval)durationSeconds {
+    if (!NSThread.isMainThread) {
+        NSString *copiedID = [identifier copy];
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [self markVisualRecordingEndForSessionIdentifier:copiedID failed:failed durationSeconds:durationSeconds];
+        });
+        return;
+    }
+    if (!self.startedAt || !identifier.length || ![identifier isEqualToString:self.sessionID]) return;
+    NSTimeInterval elapsed = STNow() - self.startedAt;
+    if (!isfinite(elapsed) || elapsed < 0 || elapsed > 3600) return;
+    for (NSDictionary *marker in self.markers)
+        if ([marker[@"name"] isEqualToString:@"visualRecordingStopped"] || [marker[@"name"] isEqualToString:@"visualRecordingFailed"]) return;
+    // One reserved terminal video marker remains possible when ordinary markers hit their cap.
+    if (self.markers.count > STMaximumMarkers) return;
+    NSTimeInterval boundedDuration = isfinite(durationSeconds) ? MAX(0, MIN(durationSeconds, 3600)) : 0;
+    NSDictionary *marker = @{@"name": failed ? @"visualRecordingFailed" : @"visualRecordingStopped",
+        @"elapsedMs": @(elapsed * 1000), @"afterJSONCaptureStop": @(!self.isRecording),
+        @"details": @{@"source": @"replaykit", @"durationSeconds": @(boundedDuration)},
+        @"snapshotID": NSNull.null, @"semanticConfirmation": @"replaykitLifecycleCallback"};
+    // The metadata reserve also covers one terminal ReplayKit callback after a
+    // payload-limit stop; it must remain exportable without restarting collection.
+    if (self.isRecording) (void)[self reservePayloadObject:marker];
+    [self.markers addObject:marker];
+    [self notifyChange];
+}
