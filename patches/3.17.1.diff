+- (void)startRecording {
+    if (!NSThread.isMainThread) { dispatch_async(dispatch_get_main_queue(), ^{ [self startRecording]; }); return; }
+    if (self.isRecording || self.sourceExportBusy || self.cardEarlyActive) return;
+    self.cardInvestigationRequested = ST_CARD_GAME_FEATURE_ENABLED && self.startingCardInvestigation;
+    self.cardFlowRequested = ST_CARD_GAME_FEATURE_ENABLED && self.startingCardInvestigation && self.startingCardFlow;
+    [self.cardFlowSamples removeAllObjects];
+    [self.cardInvestigationSamples removeAllObjects];
+    if (!ST_CARD_GAME_FEATURE_ENABLED) self.cardInvestigationGate = @"feature_disabled";
+    else if (!self.startingCardInvestigation) self.cardInvestigationGate = @"not_requested";
+    [self setCardHintsEnabled:NO];
+    if (!self.startingNewGameCapture) {
+        [self cancelNewGameDetection];
+        self.detectedGameCaptureScoped = NO;
+        self.detectedGameIdentity = @{};
+        self.detectedGameState = @"idle";
+    }
+    if (UIApplication.sharedApplication.applicationState != UIApplicationStateActive) {
+        self.startFailure = @"inactiveApplication";
+        [self notifyChange];
+        return;
+    }
+    [self pauseAutoplayWithReason:@"recording_started"];
+    [self setXrayEnabled:NO];
+    if (![self ensureEventObservation]) {
+        self.startFailure = @"eventObservationUnavailable";
+        [self notifyChange];
+        return;
+    }
+    self.generation++;
+    self.startFailure = @"";
+    self.nextTouchID = 0;
+    self.eventSnapshotCount = 0;
+    self.payloadBytes = 0;
+    self.fullWebSamples = 0;
+    self.deltaWebSamples = 0;
+    self.deduplicatedWebSamples = 0;
+    self.sceneFullPayloadBytes = 0;
+    self.sceneEncodedPayloadBytes = 0;
+    self.sceneMaximumDependencyDepth = 0;
+    self.truncatedWebSamples = 0;
+    self.exportDroppedWebSamples = 0;
+    self.firstWebElapsedMs = -1;
+    self.lastWebElapsedMs = -1;
+    self.returnTraceActive = NO;
+    self.returnTraceRequested = NO;
+    self.returnTraceStartedElapsedMs = 0;
+    self.returnTraceRequestedSamples = 0;
+    self.returnTraceMetadataSamples = 0;
+    self.returnTracePartialSamples = 0;
+    [self.sceneCodec reset];
+    self.cachedGameWebView = nil;
+    self.cachedGameController = nil;
+    self.cachedNativeSnapshotID = nil;
+    self.webCacheValidatedAt = 0;
+    self.startedAt = STNow();
+    self.stoppedAt = 0;
+    self.lastEventSnapshotAt = 0;
+    self.afterSnapshotPending = NO;
+    self.stopReason = @"recording";
+    self.sessionID = NSUUID.UUID.UUIDString;
+    self.startedDate = [[NSISO8601DateFormatter new] stringFromDate:NSDate.date];
+    [self.touches removeAllObjects]; [self.snapshots removeAllObjects]; [self.markers removeAllObjects];
+    [self.webSamples removeAllObjects]; [self.webProbe reset];
+    [self.webProbe setCardInvestigationEnabled:self.cardInvestigationRequested];
+    [self.webProbe setCardFlowEnabled:self.cardFlowRequested];
+    [self.omitted removeAllObjects]; [self.touchIDs removeAllObjects]; [self.lastMove removeAllObjects];
+    self.unfinishedTouchIDs = @[];
+    self.recording = YES;
+    [self captureSnapshot:@"recordingStarted"];
+    __weak STRecorder *weakSelf = self;
+    NSUInteger generation = self.generation;
+    self.timer = [NSTimer timerWithTimeInterval:1.0 repeats:YES block:^(__unused NSTimer *timer) {
+        STRecorder *strongSelf = weakSelf;
+        if (!strongSelf.isRecording || strongSelf.generation != generation) return;
+        if (STNow() - strongSelf.startedAt >= (strongSelf.cardInvestigationRequested ? 90.0 : STMaximumDuration)) {
+            [strongSelf stopRecordingWithReason:@"durationLimit"];
+        } else if (strongSelf.touches.count >= STMaximumTouchSamples) {
+            [strongSelf stopRecordingWithReason:@"touchLimit"];
+        } else {
+            [strongSelf captureSnapshot:@"periodic"];
+            [strongSelf notifyChange];
+        }
+    }];
+    [[NSRunLoop mainRunLoop] addTimer:self.timer forMode:NSRunLoopCommonModes];
+    self.webTimer = [NSTimer timerWithTimeInterval:(self.cardInvestigationRequested ? 0.5 : STWebInterval) repeats:YES block:^(__unused NSTimer *timer) {
+        STRecorder *strongSelf = weakSelf;
+        if (!strongSelf.isRecording || strongSelf.generation != generation) return;
+        if (STNow() - strongSelf.startedAt >= (strongSelf.cardInvestigationRequested ? 90.0 : STMaximumDuration)) [strongSelf stopRecordingWithReason:@"durationLimit"];
