+- (void)exportBilliardsLive {
+    if (STRecorder.shared.sourceExportBusy || self.videoState!=STVideoIdle || self.pendingPreview || self.controller.presentedViewController) {
+        [self showNotice:@"Finalize a exportação ou janela aberta antes de compartilhar."]; return;
+    }
