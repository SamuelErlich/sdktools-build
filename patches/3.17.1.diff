+- (void)togglePanel {
+    self.expanded = !self.expanded;
+    self.panel.hidden = !self.expanded;
+    self.view.accessibilityViewIsModal = self.expanded;
+    [self.bubble setImage:[UIImage systemImageNamed:self.expanded ? @"xmark" : @"square.stack.3d.up.fill"] forState:UIControlStateNormal];
+    self.bubble.accessibilityLabel = self.expanded ? @"Fechar SDKtools" : @"Abrir SDKtools";
+    [self.owner refresh];
+}
