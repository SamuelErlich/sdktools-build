+- (NSData *)compactReportDataWithError:(NSError **)error {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:[self reportObject] options:NSJSONWritingSortedKeys error:error];
+    // The incremental budget reserves 256 KiB for metadata and small late fields.
