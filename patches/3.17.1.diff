+// Only native object identity is compared in memory. This cannot identify a
+// Unity scene, a game type or a match, and is never written into the report.
+static NSSet *STBilliardsExportNativeContext(void) {
+    if (!NSThread.isMainThread || UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return nil;
+    NSMutableOrderedSet<UIWindow *> *windows = [NSMutableOrderedSet orderedSet];
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if ([scene isKindOfClass:UIWindowScene.class] && scene.activationState == UISceneActivationStateForegroundActive)
+            [windows addObjectsFromArray:((UIWindowScene *)scene).windows];
+    }
+    if (!windows.count) [windows addObjectsFromArray:UIApplication.sharedApplication.windows];
+    if (windows.count > 16) return nil;
+    NSMutableSet *context = [NSMutableSet set];
+    NSUInteger hostWindows = 0;
+    for (UIWindow *window in windows) {
+        if (STIsOwnWindow(window) && !window.hidden && window.rootViewController.presentedViewController) return nil;
+        if (!STWindowUsable(window)) continue;
+        if (++hostWindows > 8) return nil;
+        BOOL complete = NO;
+        NSArray *controllers = STVisibleControllersChecked(window, &complete);
+        if (!complete || !controllers.count) return nil;
+        [context addObject:window];
+        [context addObjectsFromArray:controllers];
+        for (UIViewController *controller in controllers) {
+            if (controller.isBeingPresented || controller.isBeingDismissed || controller.transitionCoordinator) return nil;
+            [context addObject:controller.view];
+        }
+    }
+    return hostWindows ? [context copy] : nil;
+}
