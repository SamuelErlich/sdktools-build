+- (BOOL)performOriginalPowerAtSlot:(NSString *)slot command:(NSString *)command update:(void (^)(NSDictionary<NSString *,id> *))update {
+    NSAssert(NSThread.isMainThread, @"STRecorder requires the main thread");
+    if (self.cardHintsEnabled || self.cardHintsBusy || self.detectedGameDetectionActive || self.detectedGameCaptureActive) {
+        update(@{@"status": @"no_action", @"reason": @"native_context_unavailable", @"dispatched": @NO, @"physicalPending": @NO}); return NO;
+    }
+    if (!([@[@"left", @"center", @"right"] containsObject:slot] || ([slot isEqual:@"current"] && [command isEqual:@"confirm"])) ||
+        ![@[@"open", @"confirm"] containsObject:command]) {
+        update(@{@"status": @"no_action", @"reason": @"invalid_options", @"dispatched": @NO, @"physicalPending": @NO}); return NO;
+    }
+    if (self.sourceExportBusy) { update(@{@"status": @"no_action", @"reason": @"source_export_pending", @"dispatched": @NO, @"physicalPending": @NO}); return NO; }
+    [self pauseAutoplayWithReason:@"power_requested"];
+    if (self.returnActionBusy) {
+        // Reject the new tap without unlocking or overwriting the older request.
+        update(@{@"status": @"no_action", @"reason": @"return_action_pending", @"dispatched": @NO,
+                 @"physicalPending": @YES, @"popupConfirmationRequired": @NO, @"boardEffectConfirmed": @NO});
+        return NO;
+    }
+    NSString *reason = nil;
+    WKWebView *webView = nil;
+    @try { webView = STFindReturnActionWebView(&reason); }
+    @catch (__unused NSException *exception) { reason = @"native_context_unavailable"; }
+    if (!webView) {
+        self.returnActionStatus = reason ?: @"native_context_unavailable";
+        NSDictionary *event = @{@"status": @"no_action", @"reason": self.returnActionStatus, @"dispatched": @NO,
+            @"physicalPending": @NO, @"popupConfirmationRequired": @NO, @"boardEffectConfirmed": @NO,
+            @"runtimeValidated": @NO, @"actionSequence": @(++self.returnActionSerial),
+            @"captureSessionID": self.isRecording ? self.sessionID : (id)NSNull.null,
+            @"requestedElapsedMs": self.isRecording ? @(STFinite(MAX(0, (STNow() - self.startedAt) * 1000))) : (id)NSNull.null,
+            @"requestAgeMs": @0, @"scope": @"explicit_original_power_action", @"slot": slot, @"command": command,
+            @"nativeGate": STLastActionGateDiagnostics ?: @{}};
+        if (self.returnActionEvents.count >= 24) [self.returnActionEvents removeObjectAtIndex:0];
+        [self.returnActionEvents addObject:event];
+        update(event);
+        [self notifyChange];
+        return NO;
+    }
+    // Set before entering the bridge; even a synchronous callback cannot leave a
+    // second tap eligible. Capture start/stop never resets this action state.
+    self.returnActionBusy = YES;
+    self.returnActionStatus = [command isEqual:@"open"] ? @"opening_original_confirmation" : @"confirming_original_power";
+    NSUInteger serial = ++self.returnActionSerial;
+    NSTimeInterval requestedAt = STNow();
+    NSString *captureID = self.isRecording ? [self.sessionID copy] : nil;
+    NSNumber *captureElapsed = self.isRecording ? @(STFinite(MAX(0, (requestedAt - self.startedAt) * 1000))) : nil;
+    if (self.isRecording) [self markEvent:@"returnActionRequested" details:@{@"source": @"overlay"}];
+    [self notifyChange];
+    NSURL *initialURL = [webView.URL copy]; // Compared in memory only; never exported.
+    __weak WKWebView *weakWebView = webView;
+    __weak UIWindow *weakWindow = webView.window;
+    NSUInteger actionContextGeneration = self.actionContextGeneration;
+    __weak STRecorder *weakSelf = self;
+    return [self.webProbe performOriginalPowerInWebView:webView slot:slot command:command validateContext:^BOOL {
+        WKWebView *expected = weakWebView;
+        STRecorder *strongSelf = weakSelf;
+        if (!expected || !strongSelf || strongSelf.actionContextGeneration != actionContextGeneration ||
+            !weakWindow || expected.window != weakWindow || expected.loading || ![expected.URL isEqual:initialURL]) return NO;
+        NSString *currentReason = nil;
+        @try { return STFindReturnActionWebView(&currentReason) == expected; }
+        @catch (__unused NSException *exception) { return NO; }
+    } update:^(NSDictionary *result) {
+        STRecorder *strongSelf = weakSelf;
+        if (!strongSelf || strongSelf.returnActionSerial != serial) return;
+        strongSelf.returnActionBusy = [result[@"physicalPending"] boolValue];
+        strongSelf.returnActionStatus = result[@"status"] ?: @"dispatch_uncertain";
+        NSMutableDictionary *event = [result mutableCopy];
+        event[@"actionSequence"] = @(serial);
+        event[@"captureSessionID"] = captureID ?: (id)NSNull.null;
+        event[@"requestedElapsedMs"] = captureElapsed ?: (id)NSNull.null;
+        event[@"requestAgeMs"] = @(STFinite(MAX(0, (STNow() - requestedAt) * 1000)));
+        event[@"scope"] = @"explicit_original_power_action";
+        event[@"slot"] = slot; event[@"command"] = command;
+        event[@"nativeGate"] = STLastActionGateDiagnostics ?: @{};
+        // Bounded in-memory diagnostics are exported only on an explicit report
+        // request. They also work when no scene recording was started.
+        if (strongSelf.returnActionEvents.count >= 24) [strongSelf.returnActionEvents removeObjectAtIndex:0];
+        [strongSelf.returnActionEvents addObject:[event copy]];
+        update(event);
+        [strongSelf notifyChange];
+    }];
+}
