+- (void)toggleBilliards {
+    if (STRecorder.shared.cardEarlyActive) { [self showNotice:@"Pare a captura de Cartas antes do bilhar."]; return; }
+    [STRecorder.shared setCardHintsEnabled:NO];
+    STBilliardsRuntime *runtime=STBilliardsRuntime.shared;
+    if (runtime.enabled) { [runtime stopWithReason:@"user"]; [self refresh]; return; }
+    if (self.videoState!=STVideoIdle || self.pendingPreview || self.controller.presentedViewController) {
+        [self showNotice:@"Feche a janela ou a captura aberta antes de ativar o bilhar."]; return;
+    }
+    NSError *error=nil;
+    if (![runtime startInWindow:self.window error:&error]) {
+        [self showNotice:error.localizedDescription ?: @"Não foi possível iniciar a leitura do bilhar."]; return;
+    }
