+def card(zone='hand', card_id=69, known=False, slot=1, **extra):
+    row = {'zone': zone, 'index': 0, 'id': card_id, 'type': 1 if known else 0,
+           'color': 1 if known else 0, 'num': 7 if known else 0,
+           'objectID': 'ec2' if known else 'ec1'}
+    if zone == 'hand':
+        row['slot'] = slot
+    row.update(extra)
+    return row
+
+
+def event(sequence=1, stage='socket_decoded_response', cards=None, **extra):
+    row = {'sequence': sequence, 'stage': stage, 'callID': sequence, 'parentCallID': 0,
+           'elapsedMs': sequence * 10, 'connectionGeneration': 1, 'round': 1,
+           'truncated': False, 'cards': cards if cards is not None else [card(), card('selected', known=True)]}
+    if stage == 'socket_decoded_response':
+        row['command'] = 'CMD_SYNC'
+    row.update(extra)
+    return row
+
+
+def observation(events=None, **extra):
+    events = [event()] if events is None else events
+    row = {'version': 1, 'status': 'ready', 'reason': 'observing', 'elapsedMs': 90000,
+           'events': events, 'milestones': {key: key != 'lateAttach' for key in analysis.MILESTONES},
+           'counters': {'lastSequence': max([e['sequence'] for e in events] + [0]),
+                        'decodedResponses': sum(e['stage'] == 'socket_decoded_response' for e in events),
+                        'bytesQueued': 0}, 'gaps': [], 'nativeOmittedEvents': 0}
+    row.update(extra)
+    return row
+
+
+def capture(events=None, **extra):
+    early = {'version': 1, 'gameType': 2007, 'generation': 1, 'documentGeneration': 1,
+             'native': {'helloReceived': True, 'scriptInstalled': True, 'finalDrainReceived': True, 'finalDrainConfirmed': True},
+             'samples': [{'kind': 'end', 'nativeElapsedMs': 90000, 'observation': observation(events)}]}
+    early.update(extra)
+    return {'schemaVersion': 3, 'format': 'SDKtools.Capture', 'cardEarly': early}
+
