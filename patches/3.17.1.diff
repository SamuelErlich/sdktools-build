+- (void)complete:(id)result error:(NSError *)error;
+@end
+@implementation WKWebView
+- (instancetype)init { if ((self = [super init])) { _window = [NSObject new]; _alpha = 1; } return self; }
+- (void)evaluateJavaScript:(NSString *)script completionHandler:(void (^)(id, NSError *))completion {
+    self.submissions++; self.lastScript = script;
