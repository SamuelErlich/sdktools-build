+static BOOL STIsOwnWindow(UIWindow *window) {
+    Class overlay = NSClassFromString(@"STOverlayWindow");
+    if (overlay && [window isKindOfClass:overlay]) return YES;
+    // Walk actual runtime classes, including subclasses. No description or view text is read.
+    for (Class cls = object_getClass(window); cls; cls = class_getSuperclass(cls))
+        if ([NSStringFromClass(cls) isEqualToString:@"STOverlayWindow"]) return YES;
+    return NO;
+}
+static BOOL STIsKeyboard(id object) {
+    for (Class cls = object_getClass(object); cls; cls = class_getSuperclass(cls)) {
+        NSString *name = NSStringFromClass(cls);
+        if ([name containsString:@"Keyboard"] || [name containsString:@"InputSet"] ||
+            [name containsString:@"TextEffects"] || [name isEqualToString:@"UIInputWindow"]) return YES;
+    }
+    return NO;
+}
+static BOOL STIsTextEntry(UIView *view) {
+    if ([view isKindOfClass:UITextField.class] || [view isKindOfClass:UITextView.class]) return YES;
+    if ([view conformsToProtocol:@protocol(UITextInputTraits)] &&
+        [view respondsToSelector:@selector(isSecureTextEntry)] && [(id<UITextInputTraits>)view isSecureTextEntry]) return YES;
+    // WKContentView implements UITextInput even for a noneditable game canvas.
+    // Inspect a BOOL editing flag, never the input value or an arbitrary KVC property.
+    if (![view conformsToProtocol:@protocol(UITextInput)]) return NO;
+    SEL selector = NSSelectorFromString(@"isEditable");
+    Method method = class_getInstanceMethod(object_getClass(view), selector);
+    char type[8] = {0};
+    if (!method || method_getNumberOfArguments(method) != 2) return NO;
+    method_getReturnType(method, type, sizeof(type));
+    if (strcmp(type, "B") && strcmp(type, "c")) return NO;
+    return ((BOOL (*)(id, SEL))objc_msgSend)(view, selector);
+}
+static BOOL STWindowUsable(UIWindow *window) {
+    if (!window || window.hidden || window.alpha < 0.01 || STIsOwnWindow(window) || STIsKeyboard(window)) return NO;
