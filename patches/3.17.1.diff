+- (NSNumber *)captureSnapshot:(NSString *)reason {
+    @try { return [self buildSnapshot:reason]; }
+    @catch (__unused NSException *exception) { [self countOmitted:@"snapshotException"]; return nil; }
+}
+
+- (NSNumber *)buildSnapshot:(NSString *)reason {
+    NSAssert(NSThread.isMainThread, @"STRecorder requires the main thread");
+    if (!self.isRecording) return nil;
+    if (self.detectedGameCaptureScoped) return [self buildNewGameSnapshot:reason];
+    if (self.snapshots.count >= STMaximumSnapshots) { [self countOmitted:@"snapshotLimit"]; return nil; }
+    NSMutableArray<UIWindow *> *windows = [NSMutableArray array];
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:UIWindowScene.class] || scene.activationState != UISceneActivationStateForegroundActive) continue;
+        for (UIWindow *window in ((UIWindowScene *)scene).windows)
+            if (STWindowUsable(window)) [windows addObject:window];
+    }
+    if (!windows.count) {
+        for (UIWindow *window in UIApplication.sharedApplication.windows)
+            if (STWindowUsable(window)) [windows addObject:window];
+    }
+    [windows sortUsingComparator:^NSComparisonResult(UIWindow *a, UIWindow *b) {
+        if (a.isKeyWindow != b.isKeyWindow) return a.isKeyWindow ? NSOrderedAscending : NSOrderedDescending;
+        if (a.windowLevel > b.windowLevel) return NSOrderedAscending;
+        if (a.windowLevel < b.windowLevel) return NSOrderedDescending;
+        return NSOrderedSame;
+    }];
+    NSMutableArray *windowReports = [NSMutableArray array];
+    NSMutableArray *nodes = [NSMutableArray array];
+    NSMutableSet *renderers = [NSMutableSet set];
+    WKWebView *gameWebView = nil;
+    UIViewController *gameController = nil;
+    BOOL truncated = windows.count > 3;
+    for (NSUInteger windowIndex = 0; windowIndex < MIN(windows.count, (NSUInteger)3); windowIndex++) {
+        UIWindow *window = windows[windowIndex];
+        NSArray<UIViewController *> *controllers = STVisibleControllers(window);
+        NSMutableArray *controllerReports = [NSMutableArray array];
+        for (UIViewController *controller in controllers) {
+            NSMutableDictionary *controllerReport = [@{@"class": STClassName(controller)} mutableCopy];
+            if (STIsCocosController(controller)) {
+                if (!gameWebView) {
+                    WKWebView *candidate = STFindGameWebView(controller.view);
+                    if (candidate) { gameWebView = candidate; gameController = controller; }
+                }
+                controllerReport[@"cocosContainerObserved"] = @YES;
+                controllerReport[@"gameTypeGetterRead"] = @NO;
+            }
+            [controllerReports addObject:controllerReport];
+        }
+        [windowReports addObject:@{@"index": @(windowIndex), @"class": STClassName(window),
+            @"boundsPoints": STRect(window.bounds), @"screenScale": @(STFinite(window.screen.scale)),
+            @"orientation": @(window.windowScene.interfaceOrientation), @"isKeyWindow": @(window.isKeyWindow),
+            @"safeAreaInsets": @{@"top": @(STFinite(window.safeAreaInsets.top)), @"left": @(STFinite(window.safeAreaInsets.left)),
+                @"bottom": @(STFinite(window.safeAreaInsets.bottom)), @"right": @(STFinite(window.safeAreaInsets.right))},
+            @"rootControllerClass": STClassName(window.rootViewController), @"visibleControllers": controllerReports}];
+        NSMutableArray<NSDictionary *> *pending = [NSMutableArray arrayWithObject:@{@"view": window, @"parent": @(-1), @"depth": @0}];
+        NSUInteger visited = 0;
+        while (pending.count && nodes.count < STMaximumViews && visited < 256) {
+            NSDictionary *item = pending.firstObject;
+            [pending removeObjectAtIndex:0];
+            visited++;
+            UIView *view = item[@"view"];
+            NSUInteger depth = [item[@"depth"] unsignedIntegerValue];
+            if (view.hidden || view.alpha < 0.01 || STIsKeyboard(view)) continue;
+            NSUInteger nodeID = nodes.count;
+            BOOL textEntry = STIsTextEntry(view);
+            CGRect windowRect = [view convertRect:view.bounds toView:window];
+            NSMutableDictionary *node = [@{@"id": @(nodeID), @"parent": item[@"parent"], @"depth": @(depth),
+                @"window": @(windowIndex), @"class": STClassName(view), @"rectInWindowPoints": STRect(windowRect),
+                @"interactive": @(view.userInteractionEnabled), @"alpha": @(STFinite(view.alpha)),
+                @"clipsToBounds": @(view.clipsToBounds), @"textEntryRedacted": @(textEntry)} mutableCopy];
+            if ([view isKindOfClass:UIControl.class]) {
+                UIControl *control = (UIControl *)view;
+                node[@"enabled"] = @(control.enabled); node[@"selected"] = @(control.selected);
+            }
+            NSString *viewClass = STClassName(view);
+            NSString *layerClass = STClassName(view.layer);
+            if ([viewClass containsString:@"Unity"] || [viewClass containsString:@"Metal"] ||
+                [layerClass isEqualToString:@"CAMetalLayer"] || [layerClass isEqualToString:@"CAEAGLLayer"]) {
+                node[@"renderSurface"] = layerClass;
+                [renderers addObject:@"nativeRenderedSurface"];
+            }
+            if ([view isKindOfClass:WKWebView.class]) {
+                [renderers addObject:@"webView"];
+            }
+            [nodes addObject:node];
+            if (textEntry) continue; // No editor contents, descendants, accessibility values, or text.
+            if (depth >= STMaximumViewDepth) { if (view.subviews.count) truncated = YES; continue; }
+            for (UIView *child in view.subviews) {
+                if (pending.count >= 256) { truncated = YES; break; }
+                [pending addObject:@{@"view": child, @"parent": @(nodeID), @"depth": @(depth + 1)}];
+            }
+        }
+        if (pending.count) truncated = YES;
+    }
+    NSNumber *snapshotID = @(self.snapshots.count + 1);
+    NSDictionary *snapshot = @{@"id": snapshotID, @"elapsedMs": @(STFinite((STNow() - self.startedAt) * 1000)),
+        @"reason": reason, @"windows": windowReports, @"views": nodes, @"truncated": @(truncated),
+        @"renderersObserved": [renderers.allObjects sortedArrayUsingSelector:@selector(compare:)],
+        @"gameWebViewEligible": @(gameWebView != nil), @"internalGameStateCaptured": @NO};
+    if (![self reservePayloadObject:snapshot]) return nil;
+    [self.snapshots addObject:snapshot];
+    // Independent 4 Hz sampling uses these weak references. Full controller/view
+    // discovery stays at native snapshot cadence instead of running every 250 ms.
+    self.cachedGameWebView = gameWebView;
+    self.cachedGameController = gameController;
+    self.cachedNativeSnapshotID = snapshotID;
+    self.webCacheValidatedAt = STNow();
+    return snapshotID;
+}
+
+- (void)sampleCachedGameWebView {
+    if (!self.isRecording) return;
+    if (self.cardInvestigationRequested && self.webSamples.count >= 200) {
+        [self stopRecordingWithReason:@"investigationSampleLimit"]; return;
+    }
+    if (self.detectedGameCaptureScoped && ![self newGameContextIsCurrent]) return;
+    if (self.webSamples.count >= STMaximumWebSamples) { [self countOmitted:@"webSampleLimit"]; return; }
+    WKWebView *webView = self.cachedGameWebView;
+    UIViewController *controller = self.cachedGameController;
+    double cacheAge = STNow() - self.webCacheValidatedAt;
+    if (!webView || !controller || cacheAge < 0 || cacheAge > 1.5 || !self.cachedNativeSnapshotID) {
+        [self countOmitted:@"webCacheUnavailableOrExpired"]; return;
+    }
+    if (!controller.isViewLoaded || !STIsCocosController(controller) || !STWindowUsable(webView.window) ||
+        controller.view.window != webView.window || ![webView isDescendantOfView:controller.view]) {
+        [self countOmitted:@"webCacheNoLongerInCocosController"]; return;
+    }
+    UIView *ancestor = webView;
+    BOOL reachedController = NO;
+    for (NSUInteger depth = 0; ancestor && depth < 16; depth++, ancestor = ancestor.superview) {
+        if (ancestor.hidden || ancestor.alpha < 0.01) { [self countOmitted:@"webCacheHiddenAncestor"]; return; }
+        if (ancestor == controller.view) { reachedController = YES; break; }
+    }
+    if (!reachedController) { [self countOmitted:@"webCacheAncestorLimit"]; return; }
+    NSUInteger generation = self.generation;
+    NSNumber *snapshotID = self.cachedNativeSnapshotID;
+    __weak STRecorder *weakSelf = self;
+    [self.webProbe sampleWebView:webView elapsedMilliseconds:(STNow() - self.startedAt) * 1000
+        completion:^(NSDictionary *sample) {
+            STRecorder *strongSelf = weakSelf;
+            if (!strongSelf.isRecording || strongSelf.generation != generation) return;
+            if (strongSelf.detectedGameCaptureScoped && ![strongSelf newGameContextIsCurrent]) return;
+            [strongSelf acceptWebSample:sample nativeSnapshotID:snapshotID cacheAgeMs:cacheAge * 1000];
+        }];
+}
+
+- (void)acceptWebSample:(NSDictionary *)sample nativeSnapshotID:(NSNumber *)snapshotID cacheAgeMs:(double)cacheAge {
+    if (!self.isRecording || self.webSamples.count >= STMaximumWebSamples) return;
+    if (self.cardInvestigationRequested && [sample[@"status"] isEqual:@"probe_document_changed"]) {
+        [self stopRecordingWithReason:@"gameContextChanged"]; return;
+    }
+    if (self.detectedGameCaptureScoped) {
+        NSString *context = [sample[@"contextID"] isKindOfClass:NSString.class] ? sample[@"contextID"] : nil;
+        if (context.length && self.detectedGameProbeContextID.length && ![context isEqual:self.detectedGameProbeContextID]) {
+            [self stopRecordingWithReason:@"gameContextChanged"]; return;
+        }
+        if (context.length) self.detectedGameProbeContextID = context;
+        NSMutableDictionary *identity = [self.detectedGameIdentity mutableCopy];
+        NSDictionary *cocos = [sample[@"cocos"] isKindOfClass:NSDictionary.class] ? sample[@"cocos"] : @{};
+        // A bridge timeout has no engine evidence. Preserve the most recent
+        // actual observation while reporting the current attempt separately.
+        if ([cocos[@"exposed"] isEqual:@YES]) {
+            identity[@"engine"] = @"cocos";
+            identity[@"engineVersion"] = cocos[@"version"] ?: @"unknown";
+        } else if ([sample[@"status"] isEqual:@"cocos_not_exposed"]) {
+            identity[@"engine"] = @"not_exposed";
+            identity[@"engineVersion"] = @"unknown";
+        }
+        identity[@"sceneStatus"] = sample[@"status"] ?: @"unavailable";
+        identity[@"sceneReadSupported"] = @([sample[@"status"] hasPrefix:@"cocos2_scene_"]);
+        self.detectedGameIdentity = identity;
+    }
+    NSMutableDictionary *linked = [sample mutableCopy];
+    // Keep investigation evidence independent of scene delta/identity codecs.
+    [linked removeObjectForKey:@"cardInvestigation"];
+    [linked removeObjectForKey:@"cardFlow"];
+    NSNumber *sequence = @(self.webSamples.count + 1);
+    linked[@"sequence"] = sequence;
+    linked[@"nativeSnapshotID"] = snapshotID;
+    linked[@"nativeSnapshotAgeMsAtRequest"] = @(STFinite(cacheAge));
+    id nodes = sample[@"sceneNodes"];
+    NSString *contextID = [sample[@"contextID"] isKindOfClass:NSString.class] ? sample[@"contextID"] : nil;
+    NSString *webViewID = [sample[@"webViewID"] isKindOfClass:NSString.class] ? sample[@"webViewID"] : nil;
+    STSceneEncodingCandidate *candidate = [nodes isKindOfClass:NSArray.class] ?
+        [self.sceneCodec prepareNodes:nodes contextID:contextID webViewID:webViewID sequence:sequence.unsignedIntegerValue] : nil;
+    if (candidate) {
+        [linked removeObjectForKey:@"sceneNodes"];
+        [linked removeObjectForKey:@"sceneNodesRefSequence"];
+        [linked removeObjectForKey:@"sceneNodesDelta"];
+        [linked addEntriesFromDictionary:candidate.fields];
+    }
+    NSData *encoded = [NSJSONSerialization dataWithJSONObject:linked options:NSJSONWritingSortedKeys error:nil];
+    if (!encoded) { [self countOmitted:@"webSampleSerializationFailed"]; return; }
+    if (encoded.length > STMaximumWebSampleBytes) {
+        [self countOmitted:@"webSamplePayloadLimit"];
+        linked = [@{@"sequence": sequence, @"nativeSnapshotID": snapshotID, @"status": @"native_sample_payload_limit",
+            @"requestedElapsedMs": sample[@"requestedElapsedMs"] ?: @0, @"rejectedCompactBytes": @(encoded.length)} mutableCopy];
+        candidate = nil;
+        encoded = [NSJSONSerialization dataWithJSONObject:linked options:NSJSONWritingSortedKeys error:nil];
+        if (!encoded) { [self countOmitted:@"webSampleSerializationFailed"]; return; }
+    }
+    if (![self reservePayloadByteCount:encoded.length]) return;
+    [self.webSamples addObject:linked];
+    if (self.cardInvestigationRequested) {
+        NSDictionary *observation = [sample[@"cardInvestigation"] isKindOfClass:NSDictionary.class] ? sample[@"cardInvestigation"] : nil;
+        NSMutableDictionary *evidence = [@{@"sequence": sequence, @"nativeSnapshotID": snapshotID,
+            @"requestedElapsedMs": sample[@"requestedElapsedMs"] ?: @0,
+            @"observation": observation ?: @{@"version": @1, @"status": @"unavailable", @"reason": @"probe_result_unavailable"}} mutableCopy];
+        if (contextID) evidence[@"contextID"] = contextID;
+        if (webViewID) evidence[@"webViewID"] = webViewID;
+        if ([self reservePayloadObject:evidence]) [self.cardInvestigationSamples addObject:evidence];
+    }
+    if (self.cardFlowRequested) {
+        NSDictionary *observation = [sample[@"cardFlow"] isKindOfClass:NSDictionary.class] ? sample[@"cardFlow"] : nil;
+        NSMutableDictionary *evidence = [@{@"sequence": sequence, @"nativeSnapshotID": snapshotID,
+            @"requestedElapsedMs": sample[@"requestedElapsedMs"] ?: @0,
+            @"observation": observation ?: @{@"version": @1, @"status": @"unavailable", @"reason": @"probe_result_unavailable", @"events": @[]}} mutableCopy];
+        if (contextID) evidence[@"contextID"] = contextID;
+        if (webViewID) evidence[@"webViewID"] = webViewID;
+        if ([self reservePayloadObject:evidence]) [self.cardFlowSamples addObject:evidence];
+    }
+    if ([sample[@"controlTraceRequested"] isEqual:@YES]) {
+        self.returnTraceRequestedSamples++;
+        NSDictionary *trace = [linked[@"controlTrace"] isKindOfClass:NSDictionary.class] ? linked[@"controlTrace"] : nil;
+        if ([trace[@"enabled"] isEqual:@YES]) {
+            self.returnTraceMetadataSamples++;
+            if ([trace[@"truncated"] isEqual:@YES]) self.returnTracePartialSamples++;
+        }
+    }
+    // Only accepted samples can become a target. A payload rejection or a
+    // stop during reservation leaves the previous materialized scene untouched.
+    if (candidate && [self.sceneCodec commitCandidate:candidate]) {
+        NSString *encoding = candidate.fields[@"sceneNodesEncoding"];
+        if ([encoding isEqualToString:@"full"]) self.fullWebSamples++;
+        else if ([encoding isEqualToString:@"delta"]) self.deltaWebSamples++;
+        else if ([encoding isEqualToString:@"reference"]) self.deduplicatedWebSamples++;
+        self.sceneFullPayloadBytes += candidate.fullPayloadBytes;
+        self.sceneEncodedPayloadBytes += candidate.encodedPayloadBytes;
+        self.sceneMaximumDependencyDepth = MAX(self.sceneMaximumDependencyDepth, candidate.dependencyDepth);
+    }
+    if ([sample[@"cocos"] isKindOfClass:NSDictionary.class] && [sample[@"cocos"][@"truncated"] boolValue]) self.truncatedWebSamples++;
+    double elapsed = [sample[@"requestedElapsedMs"] doubleValue];
+    if (isfinite(elapsed)) { if (self.firstWebElapsedMs < 0) self.firstWebElapsedMs = elapsed; self.lastWebElapsedMs = elapsed; }
