+// Observe dispatch without replacing, duplicating, cancelling, or manufacturing app input.
+// UIKit runs sendEvent on main. Unexpected off-main calls are forwarded untouched.
+static void STObservedSendEvent(UIApplication *application, SEL selector, UIEvent *event) {
+    STRecorder *recorder = STRecorder.shared;
+    NSArray<NSMutableDictionary *> *entries = nil;
+    NSUInteger generation = 0;
+    if (NSThread.isMainThread && recorder.autoplayEnabled) {
+        @try {
+            for (UITouch *touch in event.allTouches) {
+                if (touch.phase == UITouchPhaseBegan && !STIsOwnWindow(touch.window)) {
+                    [recorder pauseAutoplayWithReason:@"manual_touch"];
+                    break;
+                }
+            }
+        } @catch (__unused NSException *exception) { [recorder countOmitted:@"observationException"]; }
+    }
+    if (NSThread.isMainThread && recorder.isRecording) {
+        generation = recorder.generation;
+        @try { entries = [recorder beforeEvent:event]; }
+        @catch (__unused NSException *exception) { [recorder countOmitted:@"observationException"]; }
+    }
+    // Do not catch exceptions thrown by the original application or retry the original call.
+    ((void (*)(id, SEL, UIEvent *))STPreviousSendEvent)(application, selector, event);
+    if (NSThread.isMainThread && entries.count) {
+        @try { [recorder afterEvent:entries generation:generation]; }
+        @catch (__unused NSException *exception) { [recorder countOmitted:@"observationException"]; }
+    }
+}
