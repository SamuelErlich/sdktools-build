+- (BOOL)reservePayloadByteCount:(NSUInteger)compactBytes {
+    NSUInteger size = compactBytes < NSUIntegerMax ? compactBytes + 1 : NSUIntegerMax; // Array separator.
+    if (size > STMaximumPayloadBytes - STMetadataReserveBytes ||
+        self.payloadBytes > STMaximumPayloadBytes - STMetadataReserveBytes - size) {
+        [self countOmitted:@"payloadLimit"];
+        [self stopRecordingWithReason:@"payloadLimit"];
+        return NO;
+    }
+    self.payloadBytes += size;
+    return YES;
+}
