+- (void)openLeftPower { [self performPowerSlot:@"left" command:@"open"]; }
+- (void)openCenterPower { [self performPowerSlot:@"center" command:@"open"]; }
+- (void)openRightPower { [self performPowerSlot:@"right" command:@"open"]; }
+- (void)confirmPower { [self performPowerSlot:@"current" command:@"confirm"]; }
