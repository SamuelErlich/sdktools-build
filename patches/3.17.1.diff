+- (void)stopRecordingWithReason:(NSString *)reason {
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self stopRecordingWithReason:reason]; }); return;
+    }
+    if (!self.isRecording) return;
+    self.recording = NO;
+    self.returnTraceActive = NO;
+    self.stoppedAt = STNow();
+    NSSet *knownReasons = [NSSet setWithArray:@[@"user", @"background", @"durationLimit", @"touchLimit", @"payloadLimit", @"export", @"overlayClosed", @"gameContextChanged", @"investigationSampleLimit"]];
+    self.stopReason = [knownReasons containsObject:reason] ? reason : @"user";
+    if (self.detectedGameCaptureScoped) self.detectedGameState = @"complete";
+    self.generation++;
+    [self.timer invalidate]; self.timer = nil;
+    [self.webTimer invalidate]; self.webTimer = nil;
+    self.cachedGameWebView = nil; self.cachedGameController = nil;
+    self.afterSnapshotPending = NO;
+    [self.webProbe stop];
+    self.unfinishedTouchIDs = [[self.touchIDs objectEnumerator].allObjects sortedArrayUsingSelector:@selector(compare:)];
+    [self.touchIDs removeAllObjects]; [self.lastMove removeAllObjects];
+    [self notifyChange];
+}
