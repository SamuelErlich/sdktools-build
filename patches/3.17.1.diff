+- (void)openWarehouse {
+    if (STBilliardsRuntime.shared.enabled) { [self showNotice:@"Desative a leitura do bilhar para usar o Alpaca."]; return; }
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Aguarde a exportação terminar."]; return; }
+    if (self.controller.presentedViewController || self.pendingPreview ||
+        self.videoState == STVideoStarting || self.videoState == STVideoStopping) {
+        [self showNotice:@"Feche a janela aberta e aguarde o vídeo terminar de iniciar ou salvar."];
+        return;
+    }
+    [self showNotice:@"Conferindo seu armazém…"];
+    __weak STOverlay *weakSelf = self;
+    BOOL accepted = [STRecorder.shared openOwnWarehouseWithUpdate:^(NSDictionary *result) {
+        STOverlay *strongSelf = weakSelf;
+        if (!strongSelf) return;
+        NSString *status = result[@"status"], *reason = result[@"reason"];
+        if ([status isEqualToString:@"original_event_dispatched"]) {
+            [strongSelf showNotice:@"Pedido enviado. Confira a seleção do armazém no jogo."];
+        } else if ([status isEqualToString:@"dispatch_uncertain"]) {
+            [strongSelf showNotice:@"A resposta ainda não foi confirmada. Aguarde e confira o armazém no jogo."];
+        } else if ([reason isEqualToString:@"selection_already_open"]) {
+            [strongSelf showNotice:@"A seleção do armazém já está aberta."];
+        } else if ([reason isEqualToString:@"own_slot_locked"]) {
+            [strongSelf showNotice:@"Seu espaço está bloqueado nesta partida. O jogo precisa liberá-lo."];
+        } else if ([reason isEqualToString:@"own_slot_occupied"]) {
+            [strongSelf showNotice:@"Seu espaço já está ocupado. Confira as cartas no armazém."];
+        } else if ([reason isEqualToString:@"owner_unknown"]) {
+            [strongSelf showNotice:@"Não foi possível identificar seu armazém nesta tela."];
+        } else if ([@[@"return_action_pending", @"physical_operation_pending", @"cleanup_pending"] containsObject:reason]) {
+            [strongSelf showNotice:@"Uma ação ainda está em andamento. Aguarde antes de tentar novamente."];
+        } else if ([@[@"native_modal_visible", @"modal_visible", @"native_view_obscured", @"ambiguous_window_overlap"] containsObject:reason]) {
+            [strongSelf showNotice:@"Feche a janela aberta no jogo antes de abrir o armazém."];
+        } else {
+            [strongSelf showNotice:@"Seu armazém não está disponível nesta tela. Entre na partida e tente novamente."];
+        }
+        [strongSelf refresh];
+    }];
+    if (accepted && self.controller.expanded) [self.controller togglePanel];
+    [self refresh];
+}
