+/// Discover one visible US 6.6.2/132 hosted game, optionally requiring its type.
+/// A non-key host is valid: key status
+/// controls keyboard routing, not visibility. Real transitions and obstructions
+/// remain blocking and are diagnosed separately.
+static WKWebView *STFindHostedGameWebView(NSNumber *requiredGameType, NSNumber **observedGameType,
+                                         UIViewController **observedController, NSString **reason) {
+    if (observedGameType) *observedGameType = nil;
+    if (observedController) *observedController = nil;
+    NSDictionary *info = NSBundle.mainBundle.infoDictionary;
+    STNativeActionFacts facts = {.applicationActive = UIApplication.sharedApplication.applicationState == UIApplicationStateActive,
+        .supportedApplication = [info[@"CFBundleIdentifier"] isEqual:@"com.wejoy.weplay.us"] &&
+            [info[@"CFBundleShortVersionString"] isEqual:@"6.6.2"] && [info[@"CFBundleVersion"] isEqual:@"132"],
+        .scanComplete = true};
+    if (!facts.applicationActive || !facts.supportedApplication)
+        return STNativeGateResult(nil, reason, STNativeGateReason(STNativeActionEvaluate(facts)), facts, 0);
+    NSMutableOrderedSet<UIWindow *> *windows = [NSMutableOrderedSet orderedSet];
+    NSMutableOrderedSet<UIWindow *> *allWindows = [NSMutableOrderedSet orderedSet];
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:UIWindowScene.class] || scene.activationState != UISceneActivationStateForegroundActive) continue;
+        [allWindows addObjectsFromArray:((UIWindowScene *)scene).windows];
+    }
+    if (!allWindows.count) [allWindows addObjectsFromArray:UIApplication.sharedApplication.windows];
+    for (UIWindow *window in allWindows) {
+        // The menu itself is excluded, but its share sheet/video preview is modal.
+        if (STIsOwnWindow(window) && !window.hidden && window.rootViewController.presentedViewController) {
+            facts.nativeModalVisible = true;
+            return STNativeGateResult(nil, reason, @"native_modal_visible", facts, windows.count);
+        }
+        if (STWindowUsable(window)) [windows addObject:window];
+    }
+    if (windows.count > 8) {
+        facts.scanComplete = false;
+        return STNativeGateResult(nil, reason, @"native_scan_limit", facts, windows.count);
+    }
+    WKWebView *selected = nil;
+    UIViewController *selectedController = nil;
+    NSNumber *selectedGameType = nil;
+    for (UIWindow *window in windows) {
+        BOOL complete = NO;
+        NSArray<UIViewController *> *controllers = STVisibleControllersChecked(window, &complete);
+        if (!complete) { facts.scanComplete = false; return STNativeGateResult(nil, reason, @"native_scan_limit", facts, windows.count); }
+        for (UIViewController *controller in controllers) {
+            if ([controller isKindOfClass:UIAlertController.class]) {
+                facts.nativeModalVisible = true;
+                return STNativeGateResult(nil, reason, @"native_modal_visible", facts, windows.count);
+            }
+            if (![NSStringFromClass(object_getClass(controller)) isEqualToString:@"WPCocosGameViewController"] ||
+                !STActionViewVisible(controller.view, window, window)) continue;
+            facts.candidateVisible = true; facts.windowUsable = true;
+            facts.hostIsKeyWindow = window.isKeyWindow; facts.hostWindowLevel = window.windowLevel;
+            facts.controllerPresenting = controller.isBeingPresented;
+            facts.controllerDismissing = controller.isBeingDismissed;
+            STNativeActionGate candidateGate = STNativeActionEvaluate(facts);
+            if (candidateGate != STNativeActionReady)
+                return STNativeGateResult(nil, reason, STNativeGateReason(candidateGate), facts, windows.count);
+            for (UIViewController *visible in controllers) {
+                UIViewController *presented = visible.presentedViewController;
+                if (presented && !STControllerContains(presented, controller)) {
+                    facts.nativeModalVisible = true;
+                    return STNativeGateResult(nil, reason, @"native_modal_visible", facts, windows.count);
+                }
+            }
+            SEL selector = NSSelectorFromString(@"gameType");
+            Method getter = class_getInstanceMethod(object_getClass(controller), selector);
+            const char *encoding = getter ? method_getTypeEncoding(getter) : NULL;
+            if (!encoding || strcmp(encoding, "q16@0:8") != 0 || method_getNumberOfArguments(getter) != 2)
+                return STNativeGateResult(nil, reason, @"game_type_abi_mismatch", facts, windows.count);
+            long long gameType;
+            @try { gameType = ((long long (*)(id, SEL))objc_msgSend)(controller, selector); }
+            @catch (__unused NSException *exception) { return STNativeGateResult(nil, reason, @"game_type_unavailable", facts, windows.count); }
+            if (gameType < 0 || gameType > 1000000)
+                return STNativeGateResult(nil, reason, @"game_type_unavailable", facts, windows.count);
+            if (requiredGameType && gameType != requiredGameType.longLongValue)
+                return STNativeGateResult(nil, reason, @"different_game", facts, windows.count);
+            NSMutableArray<UIView *> *pending = [NSMutableArray arrayWithObject:controller.view];
+            NSUInteger visited = 0;
+            while (pending.count && visited++ < 256) {
+                UIView *view = pending.lastObject; [pending removeLastObject];
+                if (!STActionViewVisible(view, controller.view, window) || STIsTextEntry(view) || STIsKeyboard(view)) continue;
+                if ([view isKindOfClass:WKWebView.class]) {
+                    if (selected && (selected != view || selectedController != controller)) {
+                        facts.ambiguousWebView = true;
+                        return STNativeGateResult(nil, reason, @"ambiguous_native_webview", facts, windows.count);
+                    }
+                    selected = (WKWebView *)view;
+                    selectedController = controller;
+                    selectedGameType = @(gameType);
+                    continue;
+                }
+                if (pending.count + view.subviews.count > 256) { facts.scanComplete = false; return STNativeGateResult(nil, reason, @"native_scan_limit", facts, windows.count); }
+                [pending addObjectsFromArray:view.subviews];
+            }
+            if (pending.count) { facts.scanComplete = false; return STNativeGateResult(nil, reason, @"native_scan_limit", facts, windows.count); }
+        }
+    }
+    if (!selected || CGRectIsEmpty([selected convertRect:selected.bounds toView:selected.window]))
+        return STNativeGateResult(nil, reason, @"native_context_unavailable", facts, windows.count);
+    facts.webViewLoading = selected.loading;
+    CGPoint center = CGPointMake(CGRectGetMidX(selected.bounds), CGRectGetMidY(selected.bounds));
+    CGPoint windowPoint = [selected convertPoint:center toView:selected.window];
+    UIView *hit = [selected.window hitTest:windowPoint withEvent:nil];
+    facts.nativeObscured = hit != selected && ![hit isDescendantOfView:selected];
+    // Window level establishes ordering across levels. Key-window state does
+    // not establish touch order within a level. A hit in another same-level
+    // window is ambiguous, so wait instead of guessing which window is above.
+    for (UIWindow *other in windows) {
+        if (other == selected.window || other.windowScene != selected.window.windowScene) continue;
+        UIViewController *presented = other.rootViewController.presentedViewController;
+        if (presented && presented.isViewLoaded && presented.view.window == other && !presented.view.hidden && presented.view.alpha >= 0.01) {
+            facts.nativeModalVisible = true; break;
+        }
+        if (other.windowLevel < selected.window.windowLevel) continue;
+        for (NSUInteger sample = 0; sample < 5; sample++) {
+            CGFloat x = sample == 0 ? 0.5 : ((sample & 1) ? 0.25 : 0.75);
+            CGFloat y = sample == 0 ? 0.5 : (sample < 3 ? 0.25 : 0.75);
+            CGPoint point = CGPointMake(CGRectGetMinX(selected.bounds) + x * CGRectGetWidth(selected.bounds),
+                                       CGRectGetMinY(selected.bounds) + y * CGRectGetHeight(selected.bounds));
+            CGPoint otherPoint = [selected convertPoint:point toView:other];
+            if ([other hitTest:otherPoint withEvent:nil]) {
+                facts.nativeObscured = true;
+                facts.ambiguousWindowOverlap = other.windowLevel == selected.window.windowLevel;
+                break;
+            }
+        }
+        if (facts.nativeObscured) break;
+    }
+    STNativeActionGate gate = STNativeActionEvaluate(facts);
+    if (gate == STNativeActionReady) {
+        if (observedGameType) *observedGameType = selectedGameType;
+        if (observedController) *observedController = selectedController;
+    }
+    return STNativeGateResult(gate == STNativeActionReady ? selected : nil, reason, STNativeGateReason(gate), facts, windows.count);
+}
