+    @try { result = STFindHostedGameWebView(nil, type, controller, reason); }
+    @catch (__unused NSException *exception) { if (reason) *reason = @"native_context_unavailable"; }
+    STLastActionGateDiagnostics = previous;
+    STLastActionPolicyGate = previousGate;
+    return result;
+}
