+- (NSString *)cardHintsStatusText {
+    if (!ST_CARD_GAME_FEATURE_ENABLED) return @"Cartas desativado nesta versão.";
+    if (!self.cardHintsEnabled) {
+        if (self.cardHintsBusy) return @"Cores: encerrando a leitura…";
+        if ([self.cardHintsDiagnostic[@"reason"] isEqual:@"different_game"]) return @"Abra Ah, minha carta para ativar.";
+        if ([self.cardHintsDiagnostic[@"reason"] isEqual:@"document_changed"]) return @"A tela mudou. Ative novamente na partida.";
+        if ([self.cardHintsDiagnostic[@"status"] isEqual:@"error"]) return @"Cores indisponíveis; confira o relatório.";
+        return @"Desativado · somente Ah, minha carta";
+    }
+    NSString *status = self.cardHintsDiagnostic[@"status"], *reason = self.cardHintsDiagnostic[@"reason"];
+    if ([reason isEqual:@"native_modal_visible"] || [reason isEqual:@"native_view_obscured"] || [reason isEqual:@"ambiguous_window_overlap"])
+        return @"Aguardando fechar a janela do jogo…";
+    if ([status isEqual:@"unsupported"]) return @"Esta versão da cena ainda não é compatível.";
+    if ([status isEqual:@"error"]) return @"Leitura indisponível; aguardando atualização.";
+    NSUInteger shown = [self.cardHintsDiagnostic[@"shown"] unsignedIntegerValue];
+    NSUInteger unknown = [self.cardHintsDiagnostic[@"unknown"] unsignedIntegerValue];
+    NSUInteger unavailable = [self.cardHintsDiagnostic[@"unavailable"] unsignedIntegerValue];
+    NSUInteger special = [self.cardHintsDiagnostic[@"special"] unsignedIntegerValue];
+    if (shown || unknown || unavailable) {
+        NSString *summary = [NSString stringWithFormat:@"%lu cores · %lu especiais · %lu sem cor confirmada",
+            (unsigned long)(shown >= special ? shown - special : 0), (unsigned long)special, (unsigned long)unknown];
+        if ([self.cardHintsDiagnostic[@"rootStatus"] isEqual:@"root_ready"])
+            summary = [summary stringByAppendingFormat:@" · %lu vínculos atuais", (unsigned long)[self.cardHintsDiagnostic[@"rootBound"] unsignedIntegerValue]];
+        if (unavailable) summary = [summary stringByAppendingFormat:@" · %lu sem marcador", (unsigned long)unavailable];
+        return summary;
+    }
+    if ([reason isEqual:@"no_verified_cards"]) return @"Nenhuma carta reconhecida nesta cena.";
+    return @"Lendo as cores disponíveis nesta cena…";
+}
