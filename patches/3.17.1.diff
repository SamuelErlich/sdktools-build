+@implementation STLayerDepthSlider
+- (void)accessibilityIncrement {
+    float next = MIN(self.maximumValue, (float)((NSInteger)(self.value + 0.5f) + 1));
+    if (next == self.value) return;
+    [self setValue:next animated:NO];
+    [self sendActionsForControlEvents:UIControlEventValueChanged];
+}
+- (void)accessibilityDecrement {
+    float next = MAX(self.minimumValue, (float)((NSInteger)(self.value + 0.5f) - 1));
+    if (next == self.value) return;
+    [self setValue:next animated:NO];
+    [self sendActionsForControlEvents:UIControlEventValueChanged];
+}
+@end
