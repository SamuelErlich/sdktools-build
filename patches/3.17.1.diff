+}
+
+- (void)toggleXray {
+    if (STBilliardsRuntime.shared.enabled) { self.controller.xraySwitch.on=NO; [self showNotice:@"Desative a leitura do bilhar para usar o Alpaca."]; return; }
+    [STRecorder.shared setXrayEnabled:self.controller.xraySwitch.isOn];
+    [self refresh];
+}
+
+- (void)toggleDiagnostic {
+    STRecorder *recorder = STRecorder.shared;
+    if (recorder.recording || recorder.detectedGameDetectionActive || self.videoState != STVideoIdle) {
+        [self stopCapture];
+        [self refresh];
+        return;
+    }
+    [self startCapture];
+    if (recorder.recording && self.controller.expanded) [self.controller togglePanel];
+}
