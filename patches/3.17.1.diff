+static NSDictionary *STBilliardsExportBoundedCounts(NSDictionary *diagnostic) {
+    if (![diagnostic isKindOfClass:NSDictionary.class]) return @{};
+    NSMutableDictionary *counts = [NSMutableDictionary dictionary];
+    for (NSString *key in @[@"manifestsFound", @"manifestsAccepted", @"manifestsChanged", @"filesExported",
+        @"filesMissing", @"filesChanged", @"bytesExported", @"entriesVisited"]) {
+        id value = diagnostic[key];
+        if (![value isKindOfClass:NSNumber.class] || !isfinite([value doubleValue]) || [value doubleValue] < 0) continue;
+        double maximum = [key isEqualToString:@"bytesExported"] ? 64.0 * 1024 * 1024 : 1000000000.0;
+        counts[key] = @((unsigned long long)MIN([value doubleValue], maximum));
+    }
+    if ([diagnostic[@"truncated"] isKindOfClass:NSNumber.class]) counts[@"truncated"] = @([diagnostic[@"truncated"] boolValue]);
+    return [counts copy];
+}
