+@implementation STOverlay
+
++ (instancetype)shared {
+    static STOverlay *instance;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ instance = [STOverlay new]; });
+    return instance;
+}
+
+- (instancetype)init {
+    if ((self = [super init])) {
+        NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
+        [center addObserver:self selector:@selector(becameActive:) name:UIApplicationDidBecomeActiveNotification object:nil];
+        [center addObserver:self selector:@selector(becameActive:) name:UISceneDidActivateNotification object:nil];
+        [center addObserver:self selector:@selector(enteredBackground:) name:UIApplicationDidEnterBackgroundNotification object:nil];
+        [center addObserver:self selector:@selector(sceneEnteredBackground:) name:UISceneDidEnterBackgroundNotification object:nil];
+        [center addObserver:self selector:@selector(recorderChanged:) name:STRecorderDidChangeNotification object:nil];
+        [center addObserver:self selector:@selector(recorderChanged:) name:STBilliardsRuntimeDidChangeNotification object:nil];
+    }
+    return self;
+}
+
+- (UIWindowScene *)foregroundScene {
+    UIWindowScene *fallback = nil;
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:UIWindowScene.class] || scene.activationState != UISceneActivationStateForegroundActive) continue;
+        UIWindowScene *windowScene = (UIWindowScene *)scene;
+        for (UIWindow *window in windowScene.windows) {
+            if (![window isKindOfClass:STOverlayWindow.class] && window.isKeyWindow) return windowScene;
+        }
+        if (!fallback) fallback = windowScene;
+    }
+    return fallback;
+}
+
+- (void)installIfNeeded {
+    NSAssert(NSThread.isMainThread, @"SDKtools UI requires the main thread");
+    UIWindowScene *scene = [self foregroundScene];
+    if (UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return;
+    // Unity hosts may still use the UIApplication lifecycle without a scene
+    // manifest. In that case connectedScenes is empty and a scene-only overlay
+    // would never appear. Require a real host window in either lifecycle.
+    UIWindow *hostWindow = nil;
+    NSArray<UIWindow *> *windows = scene ? scene.windows : UIApplication.sharedApplication.windows;
+    for (UIWindow *candidate in windows) {
+        if ([candidate isKindOfClass:STOverlayWindow.class] || candidate.hidden || !candidate.rootViewController) continue;
+        if (candidate.isKeyWindow) { hostWindow = candidate; break; }
+        if (!hostWindow && candidate.windowLevel == UIWindowLevelNormal) hostWindow = candidate;
+    }
+    if (!hostWindow) return;
+    if (!self.window) {
+        self.controller = [STOverlayController new];
+        self.controller.owner = self;
+        self.window = scene ? [[STOverlayWindow alloc] initWithWindowScene:scene] : [[STOverlayWindow alloc] initWithFrame:hostWindow.bounds];
+        self.window.rootViewController = self.controller;
+        self.window.windowLevel = UIWindowLevelNormal + 5;
+        self.window.backgroundColor = UIColor.clearColor;
+        self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
+        self.window.accessibilityIdentifier = @"SDKtools.overlay";
+    } else if (scene && self.window.windowScene != scene && !self.controller.presentedViewController) {
+        self.window.hidden = YES;
+        self.window.windowScene = scene;
+    }
+    self.window.frame = scene ? scene.coordinateSpace.bounds : hostWindow.screen.bounds;
+    self.window.hidden = NO;
+    [self refresh];
+}
+
+- (void)becameActive:(NSNotification *)notification {
+    [self installIfNeeded];
+    [self presentPendingPreview];
+    [self presentPendingSourceExport];
+}
+
+- (void)sceneEnteredBackground:(NSNotification *)notification {
+    if (notification.object == self.window.windowScene) [self enteredBackground:notification];
+}
+
+- (void)enteredBackground:(NSNotification *)notification {
+    self.window.hidden = YES;
+    [self.statusTimer invalidate];
+    self.statusTimer = nil;
+    [self stopAllWithReason:@"background"];
+}
+
+- (void)recorderChanged:(NSNotification *)notification {
+    // Limits and background handling can stop JSON independently. Do not leave
+    // a screen recording running after its paired capture has ended.
+    if (!STRecorder.shared.recording && self.ownsReplayKit) {
+        if (self.videoState == STVideoStarting) self.stopWhenStarted = YES;
+        else if (self.videoState == STVideoRecording) [self stopVideo];
+    }
+    [self refresh];
+}
+
+- (void)refresh {
+    if (!NSThread.isMainThread) { dispatch_async(dispatch_get_main_queue(), ^{ [self refresh]; }); return; }
+    [self.controller refresh];
+    BOOL active = UIApplication.sharedApplication.applicationState == UIApplicationStateActive;
+    BOOL needed = active && (STBilliardsRuntime.shared.enabled || STRecorder.shared.cardEarlyActive || STRecorder.shared.cardHintsEnabled || STRecorder.shared.detectedGameDetectionActive || STRecorder.shared.sourceExportBusy || (self.controller.expanded && (STRecorder.shared.recording || self.videoState != STVideoIdle || STRecorder.shared.autoplayEnabled || STRecorder.shared.autoplayBusy || STRecorder.shared.xrayEnabled)) || self.noticeExpires > CACurrentMediaTime());
+    if (needed && !self.statusTimer) {
+        __weak typeof(self) weakSelf = self;
+        self.statusTimer = [NSTimer scheduledTimerWithTimeInterval:1 repeats:YES block:^(NSTimer *timer) { [weakSelf refresh]; }];
+    } else if (!needed && self.statusTimer) {
+        [self.statusTimer invalidate];
+        self.statusTimer = nil;
+    }
+}
+
+- (void)showNotice:(NSString *)notice {
+    self.notice = notice;
+    self.noticeExpires = CACurrentMediaTime() + 8;
+    [self refresh];
+}
+
+- (void)startCapture {
+    if (STBilliardsRuntime.shared.enabled) { [self showNotice:@"Desative a leitura do bilhar antes de iniciar outra captura."]; return; }
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Aguarde a exportação terminar."]; return; }
+    if (STRecorder.shared.recording) return;
+    if (self.videoState != STVideoIdle || self.pendingPreview || self.controller.presentedViewController) {
+        [self showNotice:@"Finalize ou salve o vídeo anterior antes de iniciar outra captura."];
+        return;
+    }
+    [STRecorder.shared startRecording];
+    if (!STRecorder.shared.recording) {
+        [self showNotice:STRecorder.shared.statusText ?: @"A captura não iniciou. Tente novamente com o app aberto."];
+        return;
+    }
+    [self showNotice:@"Diagnóstico iniciado. Jogue um pouco; depois pare e exporte em Suporte."];
+}
+
+- (void)detectNewGame {
+    if (STBilliardsRuntime.shared.enabled) { [self showNotice:@"Desative a leitura do bilhar antes de identificar outro jogo."]; return; }
+    STRecorder *recorder = STRecorder.shared;
+    if (recorder.detectedGameDetectionActive) {
+        [recorder cancelNewGameDetection]; [self showNotice:@"Detecção cancelada."]; return;
+    }
+    if (self.videoState != STVideoIdle || self.pendingPreview || self.controller.presentedViewController || ![recorder beginNewGameDetection]) {
+        [self showNotice:@"Finalize a captura ou ação em andamento antes de detectar outro jogo."]; return;
+    }
+    [self showNotice:@"Abra outro minigame. Depois volte a Suporte e toque Capturar jogo identificado."];
+    if (self.controller.expanded) [self.controller togglePanel];
+}
+
+- (void)confirmNewGame {
+    if (self.videoState != STVideoIdle || self.pendingPreview || self.controller.presentedViewController) {
+        [self showNotice:@"Finalize o vídeo ou a janela aberta antes de confirmar a captura."]; return;
+    }
+    if (![STRecorder.shared confirmNewGameCapture]) {
+        [self showNotice:@"O jogo mudou ou ainda está carregando. Aguarde a nova detecção."]; return;
+    }
+    [self showNotice:@"JSON iniciado. Jogue por 30–60 s; depois toque Parar e Exportar relatório."];
+    if (self.controller.expanded) [self.controller togglePanel];
+}
+
+- (void)traceReturn {
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Aguarde a exportação terminar."]; return; }
+    if (STRecorder.shared.returnTraceActive) {
+        [self showNotice:@"Rastreamento já ativo. Use os poderes e o armazém originais, depois pare e exporte."];
+        return;
+    }
+    if (!STRecorder.shared.recording) [self startCapture];
+    if (!STRecorder.shared.recording) return;
+    if (![STRecorder.shared beginReturnTrace]) {
+        [self showNotice:@"Não foi possível iniciar o rastreamento nesta captura. Pare e exporte o relatório atual."];
+        return;
+    }
+    [self showNotice:@"Rastreamento ativo. Use os poderes e o armazém no jogo. Depois pare a captura e exporte o JSON."];
+    if (self.controller.expanded) [self.controller togglePanel];
+}
+
+- (void)traceCardEntry {
+    STRecorder *recorder=STRecorder.shared;
+    if (recorder.cardEarlyActive) { [recorder stopCardEarlyCapture]; [self showNotice:@"Captura encerrada. Exporte o JSON de Cartas."]; return; }
+    if (STBilliardsRuntime.shared.enabled || self.videoState!=STVideoIdle || self.controller.presentedViewController) { [self showNotice:@"Finalize o bilhar, vídeo ou janela aberta antes de capturar Cartas."]; return; }
+    if (![recorder beginCardEarlyCapture]) { [self showNotice:recorder.cardEarlyStatusText]; return; }
+    [self showNotice:@"Captura armada. Entre em Ah, minha carta e jogue por 90 s."];
+    if (self.controller.expanded) [self.controller togglePanel];
+}
+- (void)toggleCardHints {
+    STRecorder *recorder=STRecorder.shared;
+    if (recorder.cardEarlyActive || STBilliardsRuntime.shared.enabled) { [self showNotice:@"Pare a captura ou o bilhar antes de ativar os marcadores."]; return; }
+    if (![recorder setCardHintsEnabled:!recorder.cardHintsEnabled]) [self showNotice:recorder.cardHintsStatusText];
+    else [self showNotice:recorder.cardHintsEnabled?@"Marcadores ativos. X cinza indica cor desconhecida.":@"Marcadores desativados."];
+    [self refresh];
+}
