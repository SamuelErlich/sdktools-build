+- (void)toggleAutoplay {
+    if (STBilliardsRuntime.shared.enabled) { [self showNotice:@"Desative a leitura do bilhar para usar o Alpaca."]; return; }
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Aguarde a exportação terminar."]; return; }
+    if (STRecorder.shared.autoplayEnabled) {
+        [STRecorder.shared pauseAutoplayWithReason:@"user"];
+        [self showNotice:STRecorder.shared.autoplayStatusText];
+        return;
+    }
+    if ([STRecorder.shared startAutoplay]) {
+        self.noticeExpires = 0;
+        if (self.controller.expanded) [self.controller togglePanel];
