+- (void)actionContextChanged:(NSNotification *)notification {
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{ self.actionContextGeneration++; [self pauseAutoplayWithReason:@"application_inactive"]; [self setXrayEnabled:NO]; [self setCardHintsEnabled:NO]; });
+    } else { self.actionContextGeneration++; [self pauseAutoplayWithReason:@"application_inactive"]; [self setXrayEnabled:NO]; [self setCardHintsEnabled:NO]; }
+    // Invalidate the context, never release a pending WebKit action early.
+}
