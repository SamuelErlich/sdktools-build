+        @"candidateObserved": @(facts.candidateVisible), @"scanComplete": @(facts.scanComplete),
+        @"applicationActive": @(facts.applicationActive), @"supportedApplication": @(facts.supportedApplication),
+        @"nativeModalVisible": @(facts.nativeModalVisible), @"nativeObscured": @(facts.nativeObscured),
+        @"ambiguousWindowOverlap": @(facts.ambiguousWindowOverlap)} mutableCopy];
+    if (facts.candidateVisible) {
+        diagnostics[@"hostIsKeyWindow"] = @(facts.hostIsKeyWindow);
+        diagnostics[@"hostWindowLevel"] = @(STFinite(facts.hostWindowLevel));
+        diagnostics[@"controllerPresenting"] = @(facts.controllerPresenting);
+        diagnostics[@"controllerDismissing"] = @(facts.controllerDismissing);
+        diagnostics[@"webViewLoading"] = @(facts.webViewLoading);
+    }
+    STLastActionGateDiagnostics = [diagnostics copy];
+    STLastActionPolicyGate = STNativeActionEvaluate(facts);
