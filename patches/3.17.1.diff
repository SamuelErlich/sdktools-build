+- (void)changeXrayDepth {
+    STLayerDepthSlider *slider = self.controller.xrayDepthSlider;
+    NSInteger depth = MAX(1, MIN(5, (NSInteger)(slider.value + 0.5f)));
+    [slider setValue:(float)depth animated:NO];
+    STSetLabelText(self.controller.xrayDepthLabel, [NSString stringWithFormat:@"Camadas abaixo: %ld", (long)depth]);
+    slider.accessibilityValue = [NSString stringWithFormat:depth == 1 ? @"%ld camada abaixo" : @"%ld camadas abaixo", (long)depth];
+    // Continuous touch events within the same step do not trigger new reads.
+    if (depth == self.controller.lastRequestedXrayDepth) return;
+    self.controller.lastRequestedXrayDepth = depth;
+    [STRecorder.shared setXrayDepth:depth];
