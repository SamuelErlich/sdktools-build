+- (CGRect)usableBounds {
+    CGRect bounds = UIEdgeInsetsInsetRect(self.view.bounds, self.view.safeAreaInsets);
+    return CGRectInset(bounds, 10, 8);
+}
+
+- (void)viewDidLayoutSubviews {
+    [super viewDidLayoutSubviews];
+    CGRect safe = [self usableBounds];
+    if (!self.dragging) {
+        CGFloat x = self.bubbleOnRight ? CGRectGetMaxX(safe) - 46 : CGRectGetMinX(safe);
+        CGFloat y = CGRectGetMinY(safe) + self.bubbleVerticalFraction * MAX(0, CGRectGetHeight(safe) - 46);
+        self.bubble.frame = CGRectMake(x, y, 46, 46);
+    }
+    CGFloat width = MIN(350, CGRectGetWidth(safe));
+    CGFloat preferredHeight = self.xrayDepthContainer.hidden ? 620 : 720;
+    if (self.dataExpanded) preferredHeight += 220;
+    if (UIContentSizeCategoryIsAccessibilityCategory(self.traitCollection.preferredContentSizeCategory)) preferredHeight += 160;
+    CGFloat height = MIN(preferredHeight, MAX(120, CGRectGetHeight(safe) - 56));
+    CGFloat x = self.bubbleOnRight ? CGRectGetMaxX(safe) - width : CGRectGetMinX(safe);
+    CGFloat y = CGRectGetMinY(safe) + 56;
+    self.panel.frame = CGRectMake(x, y, width, height);
+    self.panel.layer.shadowPath = [UIBezierPath bezierPathWithRoundedRect:self.panel.bounds cornerRadius:22].CGPath;
+    BOOL compactStatus = !self.noticeLabel.text.length;
+    CGFloat noticeWidth = MIN(compactStatus ? 200 : 300, CGRectGetWidth(safe));
+    CGSize noticeSize = [self.collapsedNoticeLabel sizeThatFits:CGSizeMake(MAX(1, noticeWidth - 16), CGFLOAT_MAX)];
+    CGFloat noticeHeight = MIN(MAX(compactStatus ? 26 : 50, noticeSize.height + (compactStatus ? 8 : 16)), CGRectGetHeight(safe));
+    CGFloat noticeX = self.bubbleOnRight ? CGRectGetMaxX(safe) - noticeWidth : CGRectGetMinX(safe);
+    CGFloat below = CGRectGetMaxY(self.bubble.frame) + 8;
+    CGFloat noticeY = below + noticeHeight <= CGRectGetMaxY(safe) ? below : CGRectGetMinY(self.bubble.frame) - noticeHeight - 8;
+    noticeY = MAX(CGRectGetMinY(safe), MIN(noticeY, CGRectGetMaxY(safe) - noticeHeight));
+    self.collapsedNoticeLabel.frame = CGRectMake(noticeX, noticeY, noticeWidth, noticeHeight);
+}
