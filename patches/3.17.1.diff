+#!/usr/bin/env python3
+"""Exercise the read-only Lua observer with mock Unity objects on Lua 5.3.
+
+Uses SDKTOOLS_LUA_LIBRARY when provided by the build gate. No game source,
+app binary or external service is executed; the fixtures are synthetic.
+"""
+from __future__ import annotations
+
+import ctypes
+import ctypes.util
+import json
+import math
+import os
+from pathlib import Path
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+PROBE = ROOT / "Resources" / "billiards_probe.lua"
+FIXTURE = ROOT / "Tests" / "test_billiards_probe.lua"
+
+
+def load_lua53():
+    configured = os.environ.get("SDKTOOLS_LUA_LIBRARY")
+    names = [configured] if configured else [
+        ctypes.util.find_library("lua5.3"),
+        ctypes.util.find_library("texlua53"),
+        "liblua5.3.so.0", "libtexlua53.so.5", "liblua5.3.dylib",
+    ]
+    errors = []
+    for name in names:
+        if not name:
+            continue
+        try:
+            lib = ctypes.CDLL(name)
+            lib.luaL_newstate.argtypes = []
+            lib.luaL_newstate.restype = ctypes.c_void_p
+            lib.luaL_openlibs.argtypes = [ctypes.c_void_p]
+            lib.lua_close.argtypes = [ctypes.c_void_p]
+            lib.luaL_loadbufferx.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t,
+                                           ctypes.c_char_p, ctypes.c_char_p]
+            lib.luaL_loadbufferx.restype = ctypes.c_int
+            lib.lua_pushlstring.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t]
+            lib.lua_pushlstring.restype = ctypes.c_void_p
+            lib.lua_pcallk.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
+                                      ctypes.c_int, ctypes.c_ssize_t, ctypes.c_void_p]
+            lib.lua_pcallk.restype = ctypes.c_int
+            lib.lua_tolstring.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(ctypes.c_size_t)]
+            lib.lua_tolstring.restype = ctypes.c_void_p
+            return lib
+        except (OSError, AttributeError) as exc:
+            errors.append(f"{name}: {exc}")
+    raise RuntimeError("Lua 5.3 library required. Set SDKTOOLS_LUA_LIBRARY. " + "; ".join(errors))
+
+
+LUA = load_lua53()
+
+
+def lua_string(state):
+    size = ctypes.c_size_t()
+    value = LUA.lua_tolstring(state, -1, ctypes.byref(size))
+    if not value:
+        raise AssertionError("Lua did not return a string")
+    return ctypes.string_at(value, size.value).decode("utf-8")
+
+
+def run_case(name):
+    state = LUA.luaL_newstate()
+    if not state:
+        raise MemoryError("luaL_newstate")
+    try:
+        LUA.luaL_openlibs(state)
+        source = FIXTURE.read_bytes()
+        status = LUA.luaL_loadbufferx(state, source, len(source), b"@SDKtools_probe_tests", b"t")
+        if status:
+            raise AssertionError(lua_string(state))
+        for value in [name, str(PROBE)]:
+            value = value.encode("utf-8")
+            LUA.lua_pushlstring(state, value, len(value))
+        status = LUA.lua_pcallk(state, 2, 1, 0, 0, None)
+        if status:
+            raise AssertionError(lua_string(state))
+        return [json.loads(line) for line in lua_string(state).splitlines()]
+    finally:
+        LUA.lua_close(state)
+
+
+class BilliardsProbeTests(unittest.TestCase):
+    def sample(self, case):
+        result = run_case(case)[0]
+        self.assertEqual(result["format"], "SDKtools.BilliardsLive")
+        self.assertEqual(result["schemaVersion"], 1)
+        self.assertEqual(result["resourceGameId"], 20)
+        self.assertEqual(result["gameType"], 1003)
+        self.assertIsInstance(result["balls"], list)
+        self.assertIsInstance(result["segments"], list)
+        self.assertLessEqual(len(result["balls"]), 16)
+        self.assertLessEqual(len(result["segments"]), 12)
+        resolution = result["resolution"]
+        self.assertEqual(resolution["schemaVersion"], 1)
+        self.assertIn(resolution["source"], {"none", "globals", "package_loaded"})
+        self.assertIn(resolution["contractStatus"], {"missing", "invalid", "conflict", "selected"})
+        lua_types = {"nil", "boolean", "number", "string", "function", "userdata", "thread", "table"}
+        for field in ["enumType", "constType", "descriptorType", "managerType", "managerGetType", "frameType"]:
+            self.assertIn(resolution[field], lua_types)
+        self.assertIsInstance(resolution["frameCallAttempted"], bool)
+        self.assertIsInstance(resolution["frameCallSucceeded"], bool)
+        if resolution["frameCallSucceeded"]:
+            self.assertTrue(resolution["frameCallAttempted"])
+        if not resolution["frameCallAttempted"]:
+            self.assertEqual(resolution["frameType"], "nil")
+        if result["status"] != "aiming":
+            self.assertFalse(result["prediction"]["available"])
+            self.assertEqual(result["segments"], [])
