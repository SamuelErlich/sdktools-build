+- (void)moveBubble:(UIPanGestureRecognizer *)gesture {
+    CGRect safe = [self usableBounds];
+    if (gesture.state == UIGestureRecognizerStateBegan) self.dragging = YES;
+    CGPoint delta = [gesture translationInView:self.view];
+    CGPoint center = self.bubble.center;
+    center.x = MIN(MAX(center.x + delta.x, CGRectGetMinX(safe) + 23), CGRectGetMaxX(safe) - 23);
+    center.y = MIN(MAX(center.y + delta.y, CGRectGetMinY(safe) + 23), CGRectGetMaxY(safe) - 23);
+    self.bubble.center = center;
+    [gesture setTranslation:CGPointZero inView:self.view];
+    if (gesture.state == UIGestureRecognizerStateEnded || gesture.state == UIGestureRecognizerStateCancelled || gesture.state == UIGestureRecognizerStateFailed) {
+        self.dragging = NO;
+        self.bubbleOnRight = center.x >= CGRectGetMidX(safe);
+        CGFloat travel = CGRectGetHeight(safe) - 46;
+        self.bubbleVerticalFraction = travel > 0 ? MIN(1, MAX(0, (center.y - 23 - CGRectGetMinY(safe)) / travel)) : 0;
+        [self.view setNeedsLayout];
+    }
+}
