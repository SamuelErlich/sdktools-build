+- (void)exportReport {
+    [STBilliardsRuntime.shared stopWithReason:@"export"];
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Aguarde a exportação terminar."]; return; }
+    if (self.pendingPreview) { [self showNotice:@"Salve ou feche a prévia do vídeo antes de exportar."]; [self presentPendingPreview]; return; }
+    if (STRecorder.shared.recording || STRecorder.shared.cardEarlyActive || self.videoState != STVideoIdle) { [self showNotice:@"Pare a captura antes de exportar o relatório."]; return; }
+    if (self.controller.presentedViewController) { [self showNotice:@"Feche a janela aberta antes de exportar."]; return; }
+    NSError *error = nil;
+    NSURL *url = [STRecorder.shared writeReportWithError:&error];
+    if (!url) {
+        if ([error.domain isEqualToString:@"SDKtools.Recorder"] && error.code == 1)
+            [self showNotice:@"Ainda não há dados. Use uma ferramenta ou toque Suporte → Iniciar diagnóstico antes de exportar."];
+        else
+            [self showNotice:@"Não foi possível gerar o JSON. Confira o espaço livre e tente novamente."];
+        return;
+    }
+    UIActivityViewController *share = [[UIActivityViewController alloc] initWithActivityItems:@[url] applicationActivities:nil];
+    share.popoverPresentationController.sourceView = self.controller.exportButton;
+    share.popoverPresentationController.sourceRect = self.controller.exportButton.bounds;
+    __weak typeof(self) weakSelf = self;
+    share.completionWithItemsHandler = ^(UIActivityType type, BOOL completed, NSArray *items, NSError *shareError) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [weakSelf showNotice:completed ? @"Relatório compartilhado." : @"Relatório disponível para exportar novamente."];
+            [weakSelf presentPendingPreview];
+        });
+    };
+    [self.controller presentViewController:share animated:YES completion:nil];
+}
