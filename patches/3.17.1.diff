+- (void)acceptCardHintsDiagnostic:(NSDictionary *)diagnostic {
+    BOOL changed = NO;
+    for (NSString *key in @[@"status", @"reason", @"shown", @"unknown", @"unavailable", @"unknownShown", @"special", @"candidates", @"rootStatus", @"rootBound", @"rootKnown", @"rootUnknown", @"rootUnbound", @"rootShown"])
+        if (![self.cardHintsDiagnostic[key] isEqual:diagnostic[key]]) { changed = YES; break; }
+    self.cardHintsDiagnostic = [diagnostic copy];
+    if (changed) {
+        NSMutableDictionary *entry = [diagnostic mutableCopy];
+        entry[@"processElapsedMs"] = @(STFinite(MAX(0, (STNow() - self.autoplayDiagnosticOrigin) * 1000)));
+        entry[@"enabled"] = @(self.cardHintsEnabled);
+        if (self.cardHintsEvents.count >= 48) [self.cardHintsEvents removeObjectAtIndex:0];
+        [self.cardHintsEvents addObject:[entry copy]];
+        [self notifyChange];
+    }
+}
