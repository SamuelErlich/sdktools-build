+- (NSDictionary<NSString *,id> *)snapshotReport {
+    if (!NSThread.isMainThread) return @{@"error": @"mainThreadRequired"};
+    // Detach mutable internal collections so callers cannot corrupt the recording state.
+    NSData *data = [NSJSONSerialization dataWithJSONObject:[self reportObject] options:NSJSONWritingSortedKeys error:nil];
+    return data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : @{@"error": @"reportSerializationFailed"};
+}
