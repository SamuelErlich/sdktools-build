+- (void)applicationBackgrounded:(NSNotification *)notification {
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self cancelNewGameDetection]; [self stopRecordingWithReason:@"background"]; });
+    } else { [self cancelNewGameDetection]; [self stopRecordingWithReason:@"background"]; }
+}
