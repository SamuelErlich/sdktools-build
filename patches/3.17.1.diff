+- (UIView *)visibleUnityView {
+    UIWindow *overlay=self.overlayWindow;
+    if (!overlay || overlay.hidden) return nil;
+    UIWindowScene *scene=overlay.windowScene;
+    if (scene && scene.activationState!=UISceneActivationStateForegroundActive) return nil;
+    NSArray<UIWindow *> *windows=scene?scene.windows:UIApplication.sharedApplication.windows;
+    Class unityClass=NSClassFromString(@"UnityView");
+    if (!unityClass) return nil;
