+- (BOOL)reservePayloadObject:(id)object {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:object options:NSJSONWritingSortedKeys error:nil];
+    if (!data) { [self countOmitted:@"payloadSerializationFailed"]; return NO; }
+    return [self reservePayloadByteCount:data.length];
+}
