+- (void)toggleVideo {
+    if (STBilliardsRuntime.shared.enabled) { [self showNotice:@"Desative a leitura do bilhar antes de iniciar outra captura."]; return; }
+    if (STRecorder.shared.sourceExportBusy) { [self showNotice:@"Aguarde a exportação terminar."]; return; }
+    if (self.videoState == STVideoRecording) { [self stopVideo]; return; }
+    if (self.videoState != STVideoIdle) return;
+    if (self.pendingPreview || self.controller.presentedViewController) { [self showNotice:@"Feche ou salve a prévia anterior antes de gravar novamente."]; return; }
+    RPScreenRecorder *recorder = RPScreenRecorder.sharedRecorder;
+    if (!recorder.isAvailable || recorder.isRecording) { [self showNotice:@"A gravação de tela não está disponível agora. O JSON pode ser gravado normalmente."]; return; }
+    if (recorder.delegate && recorder.delegate != self.replayDelegate) { [self showNotice:@"O app já utiliza o gravador de tela. O JSON está ativo; para vídeo, use a Central de Controle."]; return; }
+    if (!STRecorder.shared.recording) [STRecorder.shared startRecording];
+    if (!STRecorder.shared.recording) {
+        [self showNotice:STRecorder.shared.statusText ?: @"A captura JSON não iniciou. O vídeo não foi aberto."];
+        return;
+    }
+    self.videoCaptureSessionIdentifier = STRecorder.shared.captureSessionIdentifier;
+    NSUInteger generation = ++self.videoGeneration;
+    self.previousReplayDelegate = recorder.delegate;
+    self.previousMicrophoneEnabled = recorder.isMicrophoneEnabled;
+    self.previousCameraEnabled = recorder.isCameraEnabled;
+    self.replayDelegate = [STReplaySessionDelegate new];
+    self.replayDelegate.owner = self;
+    self.replayDelegate.generation = generation;
+    recorder.delegate = self.replayDelegate;
+    recorder.microphoneEnabled = NO;
+    recorder.cameraEnabled = NO;
+    self.ownsReplayKit = YES;
+    self.videoState = STVideoStarting;
+    self.stopWhenStarted = NO;
+    [self refresh];
+    __weak typeof(self) weakSelf = self;
+    [recorder startRecordingWithHandler:^(NSError *error) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            STOverlay *strongSelf = weakSelf;
+            if (!strongSelf || !strongSelf.ownsReplayKit || strongSelf.videoGeneration != generation) return;
+            if (error) {
+                [strongSelf markVideoEndWithError:error];
+                [strongSelf finishVideoWithPreview:nil];
+                [strongSelf showNotice:STRecorder.shared.recording ? @"O vídeo não iniciou. O JSON continua; você também pode gravar pela Central de Controle." : @"O vídeo não iniciou. A captura foi encerrada; o JSON está disponível para exportar."];
+                return;
+            }
+            strongSelf.videoState = STVideoRecording;
+            strongSelf.videoStarted = CACurrentMediaTime();
+            [STRecorder.shared markEvent:@"visualRecordingStarted" details:@{@"source": @"replaykit", @"enabled": @YES}];
+            if (strongSelf.stopWhenStarted || UIApplication.sharedApplication.applicationState != UIApplicationStateActive) [strongSelf stopVideo];
+            else [strongSelf showNotice:@"Vídeo iniciado sem microfone. Feche o menu para continuar."];
+        });
+    }];
+}
+
+- (void)stopVideo {
+    if (self.videoState != STVideoRecording || !self.ownsReplayKit) return;
+    self.videoState = STVideoStopping;
+    NSUInteger generation = self.videoGeneration;
+    [self refresh];
+    __weak typeof(self) weakSelf = self;
+    [RPScreenRecorder.sharedRecorder stopRecordingWithHandler:^(RPPreviewViewController *preview, NSError *error) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            STOverlay *strongSelf = weakSelf;
+            if (!strongSelf || !strongSelf.ownsReplayKit || strongSelf.videoGeneration != generation) return;
+            [strongSelf markVideoEndWithError:error];
+            [strongSelf finishVideoWithPreview:preview];
+            if (error) [strongSelf showNotice:@"O vídeo terminou com erro. Exporte o JSON; a prévia será exibida se estiver disponível."];
+        });
+    }];
+}
+
+- (void)markVideoEndWithError:(NSError *)error {
+    NSTimeInterval elapsed = self.videoStarted > 0 ? MAX(0, CACurrentMediaTime() - self.videoStarted) : 0;
+    if (self.videoCaptureSessionIdentifier) {
+        [STRecorder.shared markVisualRecordingEndForSessionIdentifier:self.videoCaptureSessionIdentifier failed:(error != nil) durationSeconds:elapsed];
+    }
+}
+
+- (void)finishVideoWithPreview:(RPPreviewViewController *)preview {
+    if (self.ownsReplayKit) {
+        RPScreenRecorder *recorder = RPScreenRecorder.sharedRecorder;
+        if (recorder.delegate == self.replayDelegate) {
+            recorder.delegate = self.previousReplayDelegate;
+            recorder.microphoneEnabled = self.previousMicrophoneEnabled;
+            recorder.cameraEnabled = self.previousCameraEnabled;
+        }
+    }
+    self.ownsReplayKit = NO;
+    self.videoState = STVideoIdle;
+    self.videoStarted = 0;
+    self.stopWhenStarted = NO;
+    self.previousReplayDelegate = nil;
+    self.replayDelegate = nil;
+    self.videoCaptureSessionIdentifier = nil;
+    if (self.pendingStopReason) {
+        NSString *reason = self.pendingStopReason;
+        self.pendingStopReason = nil;
+        [STRecorder.shared stopRecordingWithReason:reason];
+    }
+    if (preview) {
+        preview.previewControllerDelegate = self;
+        if (UIDevice.currentDevice.userInterfaceIdiom == UIUserInterfaceIdiomPad) {
+            preview.modalPresentationStyle = UIModalPresentationPopover;
+            preview.popoverPresentationController.sourceView = self.controller.bubble;
+            preview.popoverPresentationController.sourceRect = self.controller.bubble.bounds;
+            preview.preferredContentSize = CGSizeMake(540, 620);
+        } else preview.modalPresentationStyle = UIModalPresentationFullScreen;
+        self.pendingPreview = preview;
+    }
+    [self refresh];
+    [self presentPendingPreview];
+}
+
+- (void)presentPendingPreview {
+    if (!self.pendingPreview || self.controller.presentedViewController || UIApplication.sharedApplication.applicationState != UIApplicationStateActive || self.window.hidden) return;
+    RPPreviewViewController *preview = self.pendingPreview;
+    self.pendingPreview = nil;
+    [self.controller presentViewController:preview animated:YES completion:nil];
+}
+
+- (void)previewControllerDidFinish:(RPPreviewViewController *)previewController {
+    [previewController dismissViewControllerAnimated:YES completion:^{ [self showNotice:@"Vídeo encerrado. Exporte também o JSON para analisar os dois juntos."]; [self presentPendingSourceExport]; }];
+}
+
+- (void)replayDidStopWithGeneration:(NSUInteger)generation recorder:(RPScreenRecorder *)screenRecorder preview:(RPPreviewViewController *)previewViewController error:(NSError *)error {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (!self.ownsReplayKit || self.videoGeneration != generation || screenRecorder.isRecording) return;
+        [self markVideoEndWithError:error];
+        [self finishVideoWithPreview:previewViewController];
+        [self showNotice:@"A gravação de vídeo foi encerrada pelo iOS. O relatório JSON continua disponível."];
+    });
+}
+
+- (void)replayAvailabilityChangedWithGeneration:(NSUInteger)generation {
+    dispatch_async(dispatch_get_main_queue(), ^{ if (self.videoGeneration == generation) [self refresh]; });
+}
