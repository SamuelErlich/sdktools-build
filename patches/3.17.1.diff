+- (void)afterEvent:(NSArray<NSMutableDictionary *> *)entries generation:(NSUInteger)generation {
+    if (!self.isRecording || self.generation != generation) return;
+    if (self.touches.count >= STMaximumTouchSamples) { [self stopRecordingWithReason:@"touchLimit"]; return; }
+    BOOL ended = NO;
+    for (NSDictionary *entry in entries)
+        if ([entry[@"phase"] isEqualToString:@"ended"] || [entry[@"phase"] isEqualToString:@"cancelled"]) { ended = YES; break; }
+    if (!ended || self.afterSnapshotPending || self.eventSnapshotCount >= STMaximumEventSnapshots) return;
+    self.afterSnapshotPending = YES;
+    // UIKit objects are not captured by the block. The copy contains only JSON primitives.
+    NSArray *eventEntries = [entries copy];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        if (!self.isRecording || self.generation != generation) return;
+        self.afterSnapshotPending = NO;
+        if (self.eventSnapshotCount >= STMaximumEventSnapshots) return;
+        NSNumber *afterID = [self captureSnapshot:@"afterTouch"];
+        if (!afterID) return;
+        self.eventSnapshotCount++;
+        self.lastEventSnapshotAt = STNow();
+        for (NSMutableDictionary *entry in eventEntries) entry[@"afterSnapshotID"] = afterID;
+    });
+}
