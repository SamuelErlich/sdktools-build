+        !STWPStockCount(value[@"attemptCount"],1)) return STWPStockResult(@"uncertain",@"invalid_result",NO);
+    NSArray *flags=@[@"active",@"localWriteApplied",@"localRestored",@"hooksRestored",@"requestObserved",@"responseObserved",@"slotEffectConfirmed",@"testedWhileLocked"];
+    for (NSString *key in flags) if (value[key] != (__bridge id)kCFBooleanTrue && value[key] != (__bridge id)kCFBooleanFalse)
+        return STWPStockResult(@"uncertain",@"invalid_result",NO);
+    BOOL request=[value[@"requestObserved"] boolValue], response=[value[@"responseObserved"] boolValue], locked=[value[@"testedWhileLocked"] boolValue];
+    BOOL code=STWPStockCount(value[@"serverCode"],1000000), accepted=code && [value[@"serverCode"] integerValue]==200;
+    if ((request && ![value[@"attemptCount"] isEqual:@1]) || (response && (!request || !code)) || (!response && value[@"serverCode"]) ||
