+        ([value[@"status"] isEqual:@"rejected"] && !(request && response && !accepted && locked)) ||
+        ([value[@"slotEffectConfirmed"] boolValue] && !(request && response && accepted && locked && [value[@"status"] isEqual:@"accepted"])))
