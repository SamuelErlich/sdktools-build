+        @"cancelled_after_request",@"user_cancelled",@"invalid_command",@"request_not_eligible",@"original_exception",@"outbound_not_observed",@"opening_exception",@"local_restore_failed",
+        @"selector_not_opened",@"context_unavailable",@"document_unavailable",@"engine_version",@"time_budget",@"invalid_scene",@"scan_limit",@"game_ambiguous",@"store_unavailable",
+        @"owner_unavailable",@"owner_ambiguous",@"slot_unavailable",@"module_unavailable",@"unsupported_mode",@"external_mode_active",@"awaiting_setup",@"invalid_slot_state",@"own_slot_occupied",
+        @"already_unlocked",@"selection_already_open",@"observer_unavailable",@"lock_not_writable",@"socket_unavailable",@"cards_unavailable"];
+    NSMutableDictionary *safe=[@{@"version":@1,@"command":@"warehouse_test",@"status":value[@"status"],
+        @"reason":[reasons containsObject:value[@"reason"]]?value[@"reason"]:@"unrecognized_reason",@"physicalPending":@NO,@"attemptCount":value[@"attemptCount"]} mutableCopy];
+    for (NSString *key in flags) safe[key]=value[key];
+    for (NSString *key in @[@"beforeLock",@"afterLock"]) if (STWPStockCount(value[key],3)) safe[key]=value[key];
