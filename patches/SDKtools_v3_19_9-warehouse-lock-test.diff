+    if (!s) return @"Teste experimental: uma tentativa no próprio slot vazio.";
+    if ([s isEqual:@"armed"]) return @"Escolha UMA carta no seletor. Depois toque em Ver resultado.";
+    if ([s isEqual:@"submitted"]) return @"Pedido original observado; consulte o retorno.";
+    if ([s isEqual:@"accepted"]) return [d[@"slotEffectConfirmed"] boolValue] ?
+        @"Servidor 200 + carta no slot confirmada. Não prova uso ilimitado." : @"Servidor 200; carta no slot ainda não confirmada. Consulte novamente.";
+    if ([s isEqual:@"rejected"]) return [NSString stringWithFormat:@"Servidor recusou (código %@). Trava local restaurada.",d[@"serverCode"] ?: @0];
+    if ([s isEqual:@"uncertain"]) return @"Resultado incerto. Não repita o pedido; confira ou reabra a partida.";
+    if ([s isEqual:@"expired"]) return @"Seleção expirou sem pedido observado.";
+    if ([s isEqual:@"cancelled"]) return @"Teste encerrado; observadores removidos.";
+    if ([d[@"reason"] isEqual:@"already_unlocked"]) return @"Seu slot já está destravado; teste não necessário.";
+    if ([d[@"reason"] isEqual:@"own_slot_occupied"]) return @"Esvazie seu próprio slot antes do teste.";
+    if ([s isEqual:@"idle"]) return @"Nenhum teste neste documento.";
+    return @"Teste não armado. Confira modo em time, slot vazio e conexão.";
+}
